@page "/"
@page "/{culture}"

@using SD.WEB.Modules.Collections.Core
@using SD.WEB.Modules.EditorsChoice
@using SD.WEB.Modules.FreeToWatch
@using SD.WEB.Modules.Popular
@using SD.WEB.Modules.Profile.Core
@using SD.WEB.Modules.AwardsOfTheYear.Components
@using SD.WEB.Modules.Trailers.Components
@using SD.WEB.Modules.News.Components
@inherits PageCore<Index>

@inject WatchingListApi WatchingApi
@inject WishListApi WishApi
@inject TmdbListApi TmdbListApi
@inject TmdbSearchKeywordApi TmdbSearchKeywordApi

<HeadComponent Title="@Translations.Title.AppSubtitle" Description="@Translations.Description.AppDescription" Url=@($"/{Culture}") Index="@Culture.NotEmpty()" Shared="true"></HeadComponent>

<PageSectionComponent IsPageHeader="true" Image="icon/icon-71.png" Title="@AppInfo.Title" Subtitle="@Translations.Title.AppSubtitle"></PageSectionComponent>

<PageSectionComponent Title="@Translations.Module.Landing.Search">
    <BodyFragment>
        <MudTabs MinimumTabWidth="60px" TabPanelsClass="@CssHelper.Build().Small("pt")" @bind-ActivePanelIndex="@AppStateStatic.Index">
            <ChildContent>
                <MudTabPanel Text="@Translations.Module.Landing.Title">
                    <MudStack Row="true" AlignItems="AlignItems.Stretch" Spacing="2">
                        <MudTextField T="string" Label="@Translations.Module.Landing.EnterTitle" Placeholder="Example: Superman, Dune, Dexter, Andor, Henry Cavill, Leonardo DiCaprio"
                                      @bind-Text="@AppStateStatic.Query" Immediate="true" OnKeyDown="@KeyPress"
                                      Variant="Variant.Outlined" HelperText="@Translations.Module.Landing.TypeSomething" InputType="InputType.Text" Clearable="true">
                        </MudTextField>
                        <MudIconButton Href="@($"/{Culture}/search")" Disabled="AppStateStatic.Query.Empty()" Style="height:56px; width:56px; margin-top: 8px;"
                                       Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Variant="Variant.Filled"></MudIconButton>
                    </MudStack>
                </MudTabPanel>
                <MudTabPanel Text="@Translations.Module.Landing.Keywords">
                    <MudStack Row="true" AlignItems="AlignItems.Stretch" Spacing="2">
                        <MudTextField T="string" Label="@Translations.Module.Landing.EnterKeyword" Placeholder="Example: love, robot, lost, animation, superhero, family"
                                      @bind-Text="@AppStateStatic.Query" Immediate="true" OnKeyDown="@KeyPressKeyboard"
                                      Variant="Variant.Outlined" HelperText="@Translations.Module.Landing.SearchKeywords" InputType="InputType.Text" Clearable="true"
                                      OnClearButtonClick="@(() => AppStateStatic.Keywords = [])">
                        </MudTextField>
                        <MudIconButton OnClick="@SearchKeyWords" Disabled="AppStateStatic.Query.Empty()" Style="height:56px; width:56px; margin-top: 8px;"
                                       Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Variant="Variant.Filled"></MudIconButton>
                    </MudStack>
                    @foreach (var item in AppStateStatic.Keywords)
                    {
                        <MudChip T="string" Color="Color.Info" Size="AppStateStatic.Size" Href="@($"/{Culture}/search?keyword={item.id}")">
                            @item.name
                        </MudChip>
                    }
                    @if (AppStateStatic.Keywords.NotEmpty())
                    {
                        <MudChip T="string" Color="Color.Secondary" Size="AppStateStatic.Size" OnClick="@LoadMore" Disabled="@DisableLoadMore">
                            @Translations.Button.LoadMore
                        </MudChip>
                    }
                </MudTabPanel>
                <MudTabPanel Text="@Translations.Module.Landing.Advanced">
                    <MudToolBar Gutters="false" WrapContent="true">
                        <MudSelect T="MediaType?" @bind-Value="AppStateStatic.Type" Variant="Variant.Outlined" Label="@Translations.Module.Landing.Type" Clearable="true" Class="me-2">
                            @foreach (var item in Types)
                            {
                                <MudSelectItem Value="(MediaType?)item.Value">@item.Name</MudSelectItem>
                            }
                        </MudSelect>
                        @if (AppStateStatic.Type == MediaType.movie)
                        {
                            <MudSelect T="MovieGenre?" @bind-Value="AppStateStatic.MovieGenre" Variant="Variant.Outlined" Label="@Translations.Module.Landing.Genre" Clearable="true" Disabled="AppStateStatic.Type == null" Class="me-2">
                                @foreach (var item in MovieGenres)
                                {
                                    <MudSelectItem Value="(MovieGenre?)item.Value">@item.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudSelect T="TvGenre?" @bind-Value="AppStateStatic.TvGenre" Variant="Variant.Outlined" Label="@Translations.Module.Landing.Genre" Clearable="true" Disabled="AppStateStatic.Type == null" Class="me-2">
                                @foreach (var item in TvGenres)
                                {
                                    <MudSelectItem Value="(TvGenre?)item.Value">@item.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        <MudSelect T="string" @bind-Value="AppStateStatic.SortBy" Variant="Variant.Outlined" Label="@Translations.Module.Landing.SortBy" Class="me-2">
                            <MudSelectItem Value="@("original_title.asc")">original_title.asc</MudSelectItem>
                            <MudSelectItem Value="@("original_title.desc")">original_title.desc</MudSelectItem>
                            <MudSelectItem Value="@("popularity.asc")">popularity.asc</MudSelectItem>
                            <MudSelectItem Value="@("popularity.desc")">popularity.desc</MudSelectItem>
                            <MudSelectItem Value="@("revenue.asc")">revenue.asc</MudSelectItem>
                            <MudSelectItem Value="@("revenue.desc")">revenue.desc</MudSelectItem>
                            <MudSelectItem Value="@("primary_release_date.asc")">primary_release_date.asc</MudSelectItem>
                            <MudSelectItem Value="@("title.asc")">title.asc</MudSelectItem>
                            <MudSelectItem Value="@("title.desc")">title.desc</MudSelectItem>
                            <MudSelectItem Value="@("primary_release_date.desc")">primary_release_date.desc</MudSelectItem>
                            <MudSelectItem Value="@("vote_average.asc")">vote_average.asc</MudSelectItem>
                            <MudSelectItem Value="@("vote_average.desc")">vote_average.desc</MudSelectItem>
                            <MudSelectItem Value="@("vote_count.asc")">vote_count.asc</MudSelectItem>
                            <MudSelectItem Value="@("vote_count.desc")">vote_count.desc</MudSelectItem>
                        </MudSelect>
                        <MudIconButton Href="@($"/{Culture}/search")" Style="height:56px; width:56px; margin-top: 4px;"
                                       Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Variant="Variant.Filled"
                                       Disabled="@(AppStateStatic.Type == null || (AppStateStatic.Type == MediaType.movie ? AppStateStatic.MovieGenre == null : AppStateStatic.TvGenre == null))"></MudIconButton>
                    </MudToolBar>
                </MudTabPanel>
            </ChildContent>
        </MudTabs>
    </BodyFragment>
</PageSectionComponent>

<PopularIndexComponent WatchingList="Watching" WishList="Wish" Culture="@Culture"></PopularIndexComponent>

<FreeToWatchComponent WatchingList="Watching" WishList="Wish" Culture="@Culture"></FreeToWatchComponent>

<Advertising Slot="@AdSlot.Middle"></Advertising>

<EditorsChoiceComponent Watching="Watching" Wish="Wish" Culture="@Culture"></EditorsChoiceComponent>

<AwardsOfTheYearComponent Watching="Watching" Wish="Wish" Culture="@Culture"></AwardsOfTheYearComponent>

<Advertising Slot="@AdSlot.Middle"></Advertising>

<PageSectionComponent Title="@Translations.Title.ExpectedMovieOfYear.CustomFormat(DateTime.Now.Year)" Description="@Translations.Description.ExpectedMovies.CustomFormat(2026)">
    <BodyFragment>
        <MudTabs KeepPanelsAlive="true" MinimumTabWidth="60px" ApplyEffectsToContainer="true" TabPanelsClass="@CssHelper.Build().Small("pt")">
            <Header>
                <MudTooltip Text="Expand">
                    <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" Color="Color.Primary" Href="@($"/{Culture}/list/{(int)EnumLists.ExpectedMovieOf2026}")" />
                </MudTooltip>
            </Header>
            <ChildContent>
                <MudTabPanel Text="All">
                    <MediaListComponent MediaListApi="TmdbListApi" List="@EnumLists.ExpectedMovieOf2026" TitleHead="@Translations.Title.ExpectedMovieOfYear.CustomFormat(DateTime.Now.Year)" Watching="Watching" Wish="Wish" Culture="@Culture" />
                </MudTabPanel>
            </ChildContent>
        </MudTabs>
    </BodyFragment>
</PageSectionComponent>

<MudGrid Spacing="@CssHelper.SpaceSmall">
    <MudItem xs="12" sm="6">
        <TrailersComponent Culture="@Culture"></TrailersComponent>
    </MudItem>
    <MudItem xs="12" sm="6">
        <NewsComponent Culture="@Culture"></NewsComponent>
    </MudItem>
</MudGrid>