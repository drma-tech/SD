@using SD.WEB.Modules.Collections.Core
@inherits ComponentCore<EditorsChoiceComponent>

@inject TmdbListApi TmdbListApi

<PageSectionComponent Title="@Translations.Title.EditorsChoice" Description="@(_activeIndex == 2 ? Translations.Description.EditorsChoiceFranchise : Translations.Description.EditorsChoice.CustomFormat(TypeSelected.GetFieldSettings().Name))">
    <BodyFragment>
        <MudTabs MinimumTabWidth="60px" ApplyEffectsToContainer="true" TabPanelsClass="@CssHelper.Build().Small("pt")"
                 ActivePanelIndex="_activeIndex" ActivePanelIndexChanged="OnTabChanged" KeepPanelsAlive="true">
            <Header>
                <MudTooltip Text="Expand">
                    <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" Color="Color.Primary" Href="@($"/{Culture}/editors-choice/{(_activeIndex == 2 ? "franchise" : TypeSelected)}")" />
                </MudTooltip>
                <!--to fill in the sitemap-->
                <a href="@($"/{Culture}/editors-choice/{MediaType.movie.ToString().ToLower()}")" style="display:none;"></a>
                <a href="@($"/{Culture}/editors-choice/{MediaType.tv.ToString().ToLower()}")" style="display:none;"></a>
                <a href="@($"/{Culture}/editors-choice/franchise")" style="display:none;"></a>
            </Header>
            <ChildContent>
                <MudTabPanel Text="@MediaType.movie.GetFieldSettings().Name">
                    @if (_loaded[0])
                    {
                        <MediaListComponent MediaListApi="TmdbListApi" List="@EnumLists.CertifiedStreamingDiscoveryMovies" Watching="Watching" Wish="Wish" Culture="@Culture">
                        </MediaListComponent>
                    }
                </MudTabPanel>
                <MudTabPanel Text="@MediaType.tv.GetFieldSettings().Name">
                    @if (_loaded[1])
                    {
                        <MediaListComponent MediaListApi="TmdbListApi" List="@EnumLists.CertifiedStreamingDiscoveryShows" Watching="Watching" Wish="Wish" Culture="@Culture">
                        </MediaListComponent>
                    }
                </MudTabPanel>
                <MudTabPanel Text="@Translations.Title.Franchises" BadgeData="@("New")" BadgeColor="Color.Warning" Style="width: 180px;">
                    @if (_loaded[2])
                    {
                        <FranchiseComponent Watching="Watching" Wish="Wish"></FranchiseComponent>
                    }
                </MudTabPanel>
            </ChildContent>
        </MudTabs>
    </BodyFragment>
</PageSectionComponent>

@code {
    [Parameter][EditorRequired] public WatchingList? Watching { get; set; }
    [Parameter][EditorRequired] public WishList? Wish { get; set; }
    [Parameter][EditorRequired] public string? Culture { get; set; }

    private int _activeIndex = 0;
    private bool[] _loaded = new bool[3] { true, false, false };

    private MediaType TypeSelected => _activeIndex == 0 ? MediaType.movie : MediaType.tv;

    private void OnTabChanged(int index)
    {
        _activeIndex = index;
        _loaded[index] = true;
    }

    public Dictionary<string, string> Params { get; set; } = new() { { "mode", "compact" } };
}