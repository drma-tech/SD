@using SD.Shared.Models.Franchise

@inherits ComponentCore<FranchiseComponent>

@inject FranchiseApi FranchiseApi

<RenderControl State="State">
    <Slider List="context.Data!.FranchiseItems.Take(20)" Context="item">
        @{
            var logo = string.IsNullOrEmpty(item.Poster) ? "images/no-image.webp" : TmdbOptions.SmallPosterPath + item.Poster;
        }
        <div style="@($"width: {(AppStateStatic.IsMobile ? "110" : "130")}px")">
            <PosterComponent Poster="@logo" Title="@item.Name" Date="@item.LastReleaseDate" OnlyYear="true" WishList="Wish"
                             Clicked="@(async () => await ShowCollectionPopup(MediaType.movie, item.Id, item.Name))">
            </PosterComponent>
        </div>
    </Slider>
</RenderControl>

@code {
    [Parameter][EditorRequired] public WatchingList? Watching { get; set; }
    [Parameter][EditorRequired] public WishList? Wish { get; set; }

    public RenderControlState<FranchiseCache> State { get; set; } = new(obj => obj == null || obj.Data == null || obj.Data.FranchiseItems.Empty());

    protected override async Task LoadStaticDataAsync()
    {
        await FranchiseApi.GetItems(State, Cts.Token);
    }

    public async Task ShowCollectionPopup(MediaType type, string? collectionId, string? name)
    {
        if (collectionId.NotEmpty()) await DialogService.CollectionPopup(Watching, Wish, type, collectionId, true);
    }
}
