@page "/{culture}/company/about-us"
@inherits PageCore<AboutUsPage>

<HeadComponent Title="About Us" Description="@($"Learn about {AppInfo.CompanyName}, our mission, and the digital products we build.")" Url=@($"/{Culture}/company/about-us") Index="false"></HeadComponent>

<div class="support-container">
    @if (Language == AppLanguage.pt)
    {
        <h1 class="support-title">Sobre a @AppInfo.CompanyName</h1>
        <div class="support-subtitle">
            Bem-vindo à <b>@AppInfo.CompanyName</b> (<a href="@AppInfo.CompanyWebSite" target="_blank" rel="noopener">@AppInfo.CompanyWebSite</a>)!<br />
            Criamos produtos digitais que ajudam as pessoas a explorar possibilidades, encontrar o que combina com elas e tomar decisões com mais facilidade.
        </div>
        <div class="support-section">
            <h2>1. Nossa Missão</h2>
            <p>Nossa missão é desenvolver ferramentas digitais úteis e intuitivas que simplifiquem tarefas e ajudem as pessoas a fazer escolhas mais alinhadas às suas necessidades.</p>
        </div>
        <div class="support-section">
            <h2>2. Quem Somos</h2>
            <p>Somos uma empresa de tecnologia focada em criar e desenvolver produtos digitais. Combinamos desenvolvimento de software, análise e design para transformar ideias em ferramentas práticas.</p>
        </div>
        <div class="support-section">
            <h2>3. Nossos Produtos</h2>
            <ul>
                @foreach (var product in AppInfo.Products)
                {
                    <li><b style="color: var(--mud-palette-secondary);"><a href="@product.Url" target="_blank" rel="noopener">@product.Title</a>:</b> @product.SubTitle</li>
                }
            </ul>
        </div>
        <div class="support-section">
            <h2>4. Contato</h2>
            <p>Se você tiver dúvidas, sugestões ou quiser entrar em contato, visite nossa <a href=@($"/{Culture}/help")>página de suporte</a>.</p>
        </div>
        <div class="support-footer">
            <p>Última atualização: 6 de novembro de 2026</p>
        </div>
    }
    else if (Language == AppLanguage.es)
    {
        <h1 class="support-title">Sobre @AppInfo.CompanyName</h1>
        <div class="support-subtitle">
            ¡Bienvenido a <b>@AppInfo.CompanyName</b> (<a href="@AppInfo.CompanyWebSite" target="_blank" rel="noopener">@AppInfo.CompanyWebSite</a>)!<br />
            Creamos productos digitales que ayudan a las personas a explorar posibilidades, encontrar lo que mejor se adapta a ellas y tomar decisiones con mayor facilidad.
        </div>
        <div class="support-section">
            <h2>1. Nuestra Misión</h2>
            <p>Nuestra misión es desarrollar herramientas digitales útiles e intuitivas que simplifiquen tareas y ayuden a las personas a tomar decisiones más acordes con sus necesidades.</p>
        </div>
        <div class="support-section">
            <h2>2. Quiénes Somos</h2>
            <p>Somos una empresa tecnológica enfocada en crear y desarrollar productos digitales. Combinamos desarrollo de software, análisis y diseño para transformar ideas en herramientas prácticas.</p>
        </div>
        <div class="support-section">
            <h2>3. Nuestros Productos</h2>
            <ul>
                @foreach (var product in AppInfo.Products)
                {
                    <li><b style="color: var(--mud-palette-secondary);"><a href="@product.Url" target="_blank" rel="noopener">@product.Title</a>:</b> @product.SubTitle</li>
                }
            </ul>
        </div>
        <div class="support-section">
            <h2>4. Contacto</h2>
            <p>Si tienes preguntas, sugerencias o quieres ponerte en contacto, visita nuestra <a href=@($"/{Culture}/help")>página de soporte</a>.</p>
        </div>
        <div class="support-footer">
            <p>Última actualización: 6 de noviembre de 2026</p>
        </div>
    }
    else
    {
        <h1 class="support-title">About @AppInfo.CompanyName</h1>
        <div class="support-subtitle">
            Welcome to <b>@AppInfo.CompanyName</b> (<a href="@AppInfo.CompanyWebSite" target="_blank" rel="noopener">@AppInfo.CompanyWebSite</a>)!<br />
            We build digital products that help people explore possibilities, find what fits them, and make decisions more easily.
        </div>
        <div class="support-section">
            <h2>1. Our Mission</h2>
            <p>Our mission is to develop useful and intuitive digital tools that simplify tasks and help people make choices that better match their needs.</p>
        </div>
        <div class="support-section">
            <h2>2. Who We Are</h2>
            <p>We are a technology company focused on creating and developing digital products. We combine software development, analysis, and design to turn ideas into practical tools.</p>
        </div>
        <div class="support-section">
            <h2>3. Our Products</h2>
            <ul>
                @foreach (var product in AppInfo.Products)
                {
                    <li><b style="color: var(--mud-palette-secondary);"><a href="@product.Url" target="_blank" rel="noopener">@product.Title</a>:</b> @product.SubTitle</li>
                }
            </ul>
        </div>
        <div class="support-section">
            <h2>4. Contact</h2>
            <p>If you have questions, suggestions, or would like to get in touch, visit our <a href=@($"/{Culture}/help")>support page</a>.</p>
        </div>
        <div class="support-footer">
            <p>Last updated: November 6, 2026</p>
        </div>
    }
</div>

@code {
    public AppLanguage Language => AppStateStatic.ConvertAppLanguage(Culture, AppLanguage.en);
}
