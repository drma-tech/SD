                            <a href="@product.Url" target="_blank" rel="noopener" style="color: var(--mud-palette-secondary) !important;">
                                @product.Title
                            </a>:
                        </b> @product.Description
                    </li>
                }
            </ul>
        </div>
        <div class="support-section">
            <h2>5. Kontakt</h2>
            <p>Wir freuen uns über Ideen, Fragen und Anregungen. Sie erreichen unser Team unter <a href="mailto:contact@drma-tech.com">contact@drma-tech.com</a> oder über unsere <a href=@($"/{Culture}/help")>Support-Seite</a>.</p>
        </div>
        <div class="support-footer">
            <p>Zuletzt aktualisiert: 6. November 2026</p>
        </div>
    }
