@page "/{culture}/legal/do-not-sell"
@inherits PageCore<DoNotSellPage>

<HeadComponent Title="@Translations.Module.Legal.DoNotSell" Url=@($"/{Culture}/legal/do-not-sell") Index="false"></HeadComponent>

<div class="support-container">
    @if (Language == AppLanguage.pt)
    {
        <h1 class="support-title">Não Vender ou Compartilhar Meus Dados Pessoais</h1>
        <div class="support-section">
            <p>Não vendemos nem compartilhamos seus dados pessoais em troca de dinheiro ou qualquer outra forma de compensação.</p>
            <p>No entanto, algumas ferramentas de terceiros usadas na plataforma (como para análises ou publicidade) podem coletar dados que, segundo a Lei de Privacidade da Califórnia (CCPA/CPRA), podem ser considerados como “compartilhamento”.</p>
            <p>Você pode gerenciar suas preferências ajustando as configurações de cookies ou desativando rastreamento pelo navegador.</p>
            <p>Se você reside na Califórnia e tiver dúvidas, entre em contato: support@streamingdiscovery.com</p>
        </div>
    }
    else if (Language == AppLanguage.es)
    {
        <h1 class="support-title">No Vender ni Compartir Mi Información Personal</h1>
        <div class="support-section">
            <p>No vendemos ni compartimos su información personal a cambio de dinero u otra compensación de valor.</p>
            <p>Sin embargo, algunas herramientas de terceros utilizadas en nuestra plataforma (por ejemplo, para análisis o publicidad) pueden recopilar datos que podrían considerarse un “compartir” según la Ley de Privacidad de California (CCPA/CPRA).</p>
            <p>Puede administrar sus preferencias ajustando la configuración de cookies o desactivando el seguimiento en su navegador.</p>
            <p>Si usted reside en California y tiene preguntas, contáctenos: support@streamingdiscovery.com</p>
        </div>
    }
    else
    {
        <h1 class="support-title">Do Not Sell or Share My Personal Information</h1>
        <div class="support-section">
            <p>We do not sell personal information in exchange for money. However, some disclosures of personal information to analytics or advertising providers may be considered “sharing” for cross-context behavioral advertising under the California Consumer Privacy Act, as amended by the California Privacy Rights Act (CCPA/CPRA), even when no money is exchanged.</p>
            <p>You may request to opt out of the sale or sharing of your personal information by contacting us at <a href="mailto:support@streamingdiscovery.com">support@streamingdiscovery.com</a>. You do not need to create an account to submit a request. We will review and process your request as required by applicable privacy laws.</p>
            <p>For more information about the personal information we collect, how we use it, and the service providers that may receive it, please read our <a href=@($"/{Culture}/legal/privacy")>Privacy Policy</a>.</p>
            <p>If you have questions about this page or your privacy choices, contact us at <a href="mailto:support@streamingdiscovery.com">support@streamingdiscovery.com</a>.</p>
        </div>
        @* TODO: Implement an opt-out preference mechanism and honor applicable Global Privacy Control signals. *@
    }
</div>

@code {
    public AppLanguage Language => AppStateStatic.ConvertAppLanguage(Culture, AppLanguage.en);
}
