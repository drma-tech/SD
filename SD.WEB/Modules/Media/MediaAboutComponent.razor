@using SD.Common.Models.List
@using System.Globalization

@inherits ComponentParameterCore<MediaAboutComponent>

@inject CacheRatingsApi CacheRatingsApi
@inject ExternalIdApi ExternalIdApi

<MudStack Row="false" Breakpoint="Breakpoint.SmAndUp">
    <div Style="position: relative; min-width: 256px;">
        @if (Media?.release_date < DateTime.Now.AddMonths(-3))
        {
            <MudChip T="string" Color="Color.Info" Label="true" Style="padding: 0.2rem; position: absolute; top: 0; left: 0; height: auto; z-index: 1;">
                @Media?.release_date?.Year
            </MudChip>
        }
        else
        {
            <MudChip T="string" Color="Color.Info" Label="true" Style="padding: 0.2rem; position: absolute; top: 0; left: 0; height: auto; z-index: 1;">
                @Media?.release_date?.ToShortDateString()
            </MudChip>
        }
        <MudImage Src="@(Media?.poster_large ?? "images/no-image.webp")" Alt="@Media?.title" FallbackSrc="images/no-image.webp" Fluid="true" ObjectFit="ObjectFit.Contain"></MudImage>
    </div>
    <div>
        @if (Media?.runtime != null && Media.runtime > 0)
        {
            <CustomChip Name="@Translations.Module.Media.Duration" Value="@Media.runtime.FormatRuntime()" ColorName="Color.Info" ColorValue="Color.Info" Class="me-2"></CustomChip>
        }
        <CustomChips Name="@Translations.Module.Media.Genres" Values="@Media?.Genres" ColorName="Color.Info" ColorValue="Color.Info"></CustomChips>
        <div>
            <RenderControl State="RatingsState" LoadingHeight="40px" HideIfEmpty="true" Context="ctx">

                <CustomChip Name="@Translations.Module.Media.Ratings" TValue="string" ColorName="Color.Info"></CustomChip>

                <CustomChip Value="@ctx?.Data?.imdb" ColorValue="GetColorByRating(ctx?.Data?.imdb)" Tooltip="IMDb" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(ctx?.Data?.imdbLink))" Image="logo/imdb.png" ImageStyle="height: 20px;"></CustomChip>

                <CustomChip Value="@ctx?.Data?.tmdb" ColorValue="GetColorByRating(ctx?.Data?.tmdb)" Tooltip="TMDB" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(ctx?.Data?.tmdbLink))" Image="logo/tmdb.png" ImageStyle="height: 20px;"></CustomChip>

                <CustomChip Value="@ctx?.Data?.metacritic" ColorValue="GetColorByRating(ctx?.Data?.metacritic)" Tooltip="Metacritic" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(ctx?.Data?.metacriticLink))" Image="logo/metacritic.png" ImageStyle="height: 20px;"></CustomChip>

                <CustomChip Value="@ctx?.Data?.trakt" ColorValue="GetColorByRating(ctx?.Data?.trakt)" Tooltip="Trakt" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(ctx?.Data?.traktLink))" Image="logo/trakt.png" ImageStyle="height: 20px;"></CustomChip>

                <CustomChip Value="@ctx?.Data?.rottenTomatoes" ColorValue="GetColorByRating(ctx?.Data?.rottenTomatoes)" Tooltip="Rotten Tomatoes" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(ctx?.Data?.rottenTomatoesLink))" Image="logo/rotten-tomatoes.png" ImageStyle="height: 20px;"></CustomChip>

                <CustomChip Value="@ctx?.Data?.filmAffinity" ColorValue="GetColorByRating(ctx?.Data?.filmAffinity)" Tooltip="Film Affinity" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(ctx?.Data?.filmAffinityLink))" Image="logo/film-affinity.png" ImageStyle="height: 20px;"></CustomChip>

                <CustomChip Value="@ctx?.Data?.letterboxd" ColorValue="GetColorByRating(ctx?.Data?.letterboxd)" Tooltip="Letterboxd" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(ctx?.Data?.letterboxdLink))" Image="logo/letterboxd.png" ImageStyle="height: 20px;"></CustomChip>
               
            </RenderControl>
        </div>
        <MudText Typo="Typo.body1" Align="Align.Justify" Class="@CssHelper.Build().Small("my")">
            @Media?.plot
        </MudText>
        @if (!string.IsNullOrEmpty(Media?.homepage))
        {
            <MudPaper Outlined="true" Class="pa-2 mb-3">
                <MudText Color="Color.Primary" Typo="Typo.subtitle1">
                    @Translations.Module.Media.Homepage
                </MudText>
                <MudDivider Class="mb-2"></MudDivider>
                <MudLink OnClick="@(() => OpenExternalWebsite(Media.homepage))" Color="Color.Secondary" Style="word-break: break-all;">
                    @Media.homepage
                </MudLink>
            </MudPaper>
        }
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.Warning">
            @Translations.Module.Media.PlatformForManaging
        </MudAlert>
    </div>
</MudStack>

@code {
    [Parameter] public MediaDetail? Media { get; set; }
    [Parameter] public string? ImdbId { get; set; }
    [Parameter] public string? TmdbId { get; set; }
    [Parameter] public string? EnglishTitle { get; set; }
    [Parameter] public MediaType? Type { get; set; }

    [Parameter] public WatchingList? Watching { get; set; }
    [Parameter] public WishList? Wish { get; set; }

    private RenderControlState<RatingsCache?> RatingsState { get; set; } = new(null, obj => obj?.Data == null);

    protected override List<string?> GetParameterKey()
    {
        return [
            TmdbId,
            Type.ToString()
        ];
    }

    protected override async Task LoadParameterDataAsync()
    {
        try
        {
            ImdbId = await ExternalIdApi.GetImdbId(Type, TmdbId, Cts.Token);

            if (Media?.MediaType == MediaType.movie)
            {
                await CacheRatingsApi.GetMovieRatings(ImdbId, Media?.tmdb_id, EnglishTitle, Media?.release_date, Media?.rating?.ToString("#.#", System.Globalization.CultureInfo.InvariantCulture), RatingsState, Cts.Token);
            }
            else
            {
                await CacheRatingsApi.GetShowRatings(ImdbId, Media?.tmdb_id, EnglishTitle, Media?.release_date, Media?.rating?.ToString("#.#", System.Globalization.CultureInfo.InvariantCulture), RatingsState, Cts.Token);
            }
        }
        catch (Exception ex)
        {
            await RatingsState.ShowError.Invoke(ex.Message);
        }
    }

    private Color GetColorByRating(string? rating)
    {
        if (string.IsNullOrEmpty(rating)) return Color.Default;

        float.TryParse(rating.Replace(",", "."), NumberStyles.Any, CultureInfo.InvariantCulture, out var val);

        if (val >= 7.95f)
        {
            return Color.Success;
        }

        if (val >= 5.95f)
        {
            return Color.Warning;
        }

        return Color.Error;
    }
}
