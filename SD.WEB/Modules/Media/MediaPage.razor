@page "/{culture}/media/{type}/{id}"

@using Microsoft.AspNetCore.Authorization
@using SD.WEB.Modules.Media.Components
@using SD.WEB.Modules.Profile.Core
@using SD.WEB.Modules.Collections.Core
@using SD.WEB.Modules.Subscription.Core

@inherits PageParameterCore<MediaPage>
@implements IDisposable
@attribute [Authorize]

@inject TmdbApi TmdbApi
@inject CacheRatingsApi CacheRatingsApi
@inject ExternalIdApi ExternalIdApi
@inject WatchingListApi WatchingApi
@inject WishListApi WishApi
@inject TmdbRecommendationsApi TmdbRecommendationsApi
@inject IpInfoApi IpInfoApi

<HeadComponent Title="@Media?.title" Description="@Media?.plot" Url="@($"/{Culture}/media/{type}/{id}")" Index="false"></HeadComponent>
@if (Media?.title.NotEmpty() ?? false)
{
    <PageSectionComponent Title="@Media?.title">
        <ActionsFragment>
            @if (Wish?.Movies.Any(a => a.id == TmdbId) ?? false)
            {
                <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="@Remove" Class="me-2">
                    @Translations.Button.RemoveWishlist
                </MudButton>
            }
            else if (Wish?.Shows.Any(a => a.id == TmdbId) ?? false)
            {
                <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="@Remove" Class="me-2">
                    @Translations.Button.RemoveWishlist
                </MudButton>
            }
            else
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@Add" Class="me-2">
                    @Translations.Button.AddWishlist
                </MudButton>
            }
            @if (Watching?.Contains(Type, Watching.GetItem(Type, TmdbId ?? "")) ?? false)
            {
                <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="@IsNotWatched" Class="me-2">
                    @Translations.Button.Unfollow
                </MudButton>
            }
            else
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@IsWatched" Class="me-2">
                    @Translations.Button.Follow
                </MudButton>
            }
        </ActionsFragment>
    </PageSectionComponent>
}

<RenderControl Actions="Actions" LoadingHeight="400px">
    <ChildContent>
        <PageSectionComponent Title="@Translations.Module.Media.TabAbout" Color="Color.Secondary">
            <BodyFragment>
                <MediaAbout ImdbId="@ImdbId" TmdbId="@TmdbId" Media="@Media" EnglishTitle="@EnglishTitle" Watching="Watching" Wish="Wish" Type="Type"
                            Actions="RatingsActions" RatingsCache="_ratingsCache"></MediaAbout>
            </BodyFragment>
        </PageSectionComponent>
        <PageSectionComponent Title="@($"{Translations.Module.Media.WhereToWatch} ({Region?.GetFieldSettings().Name})")" Color="Color.Secondary">
            <BodyFragment>
                <MediaWhereToWatch TmdbId="@TmdbId" Type="@Type" ReleaseDate="@Media?.release_date"></MediaWhereToWatch>
            </BodyFragment>
        </PageSectionComponent>

        <Advertising Slot="@AdSlot.Middle"></Advertising>

        <PageSectionComponent Title="@(Media?.MediaType == MediaType.movie ? Translations.Module.Media.TabCollection1 : Translations.Module.Media.TabCollection2)" Color="Color.Secondary"
                              Visible="@(Media?.Collection.Any() ?? false)">
            <BodyFragment>
                <MediaCollectionComponent Culture="@Culture" Type="@Type" Media="@Media" Wish="@Wish" TmdbId="@TmdbId"></MediaCollectionComponent>
            </BodyFragment>
        </PageSectionComponent>

        <PageSectionComponent Title="@Translations.Module.Landing.Keywords" Color="Color.Secondary">
            <BodyFragment>
                <KeywordsComponent Culture="@Culture" TmdbId="@TmdbId" Type="@Type"></KeywordsComponent>
            </BodyFragment>
        </PageSectionComponent>

        <PageSectionComponent Title="Recommendations" Color="Color.Secondary">
            <BodyFragment>
                <RenderControl Actions="RecommendationsActions" Context="ctx">
                    <Slider List="Recommendations" Context="item">
                        <div style="@($"width: {(AppStateStatic.IsMobile ? "110" : "130")}px")">
                            <PosterComponent Poster="@item.poster_small" Title="@item.title" Clicked="@(() => OpenPopupMedia(item.MediaType, item.tmdb_id))" MediaType="@item.MediaType"
                                             Date="@item.release_date" Rating="@item.rating"
                                             WishList="Wish" TmdbId="@item.tmdb_id" Comments="@item.comments">
                            </PosterComponent>
                        </div>
                    </Slider>
                </RenderControl>
            </BodyFragment>
        </PageSectionComponent>

        <PageSectionComponent Title="Videos" Color="Color.Secondary" Visible="@(Media != null && Media.Videos.Any())">
            <BodyFragment>
                @foreach (var group in Media?.Videos.GroupBy(g => g.type).Select(s => s.Key) ?? [])
                {
                    <MudPaper Outlined="true" Class="pa-2 mb-2">
                        <MudText Color="Color.Primary" Typo="Typo.subtitle1">
                            @group
                        </MudText>
                        <MudDivider Class="mb-2"></MudDivider>
                        <MudStack Row="true" Spacing="@CssHelper.SpaceSmall" Wrap="Wrap.Wrap">
                            @foreach (var item in Media?.Videos.Where(w => w.type == group).Take(10) ?? [])
                            {
                                <div>
                                    <MudIcon Icon="@Icons.Custom.Brands.YouTube" Color="Color.Primary" Style="vertical-align: top;"></MudIcon>
                                    <MudLink OnClick="@(() => VideoClick(item))" Color="Color.Secondary"
                                             Style="@((AppStateStatic.Size == Size.Small ? "font-size: 0.8rem !important;" : "font-size: 1rem !important;"))">
                                        @item.name
                                    </MudLink>
                                </div>
                            }
                        </MudStack>
                    </MudPaper>
                }
            </BodyFragment>
        </PageSectionComponent>

        <Advertising Slot="@AdSlot.Middle"></Advertising>

        <PageSectionComponent Title="@Translations.Module.Media.TabCredits" Color="Color.Secondary">
            <BodyFragment>
                <CreditsComponent TmdbId="@TmdbId" Type="@Type" WatchingList="Watching" WishList="Wish" Culture="@Culture">
                </CreditsComponent>
            </BodyFragment>
        </PageSectionComponent>

        <PageSectionComponent Title="Reviews" Color="Color.Secondary">
            <BodyFragment>
                @if (ImdbId.NotEmpty())
                {
                    <ReviewComponent ImdbId="@ImdbId" EnglishTitle="@EnglishTitle?.RemoveSpecialCharacters().RemoveDiacritics().Replace(" ", "-").ToLower()"
                                     Type="@Type" ReleaseDate="@Media?.release_date">
                    </ReviewComponent>
                }
            </BodyFragment>
        </PageSectionComponent>
    </ChildContent>
</RenderControl>

<FloatingButton Template="Template.Back"></FloatingButton>