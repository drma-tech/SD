@using SD.Shared.Models.List
@using System.Globalization

@inherits ComponentCore<MediaAbout>

<MudStack Row="false" Breakpoint="Breakpoint.SmAndUp">
    <div Style="position: relative; min-width: 300px;">
        @if (Media?.release_date < DateTime.Now.AddMonths(-3))
        {
            <MudChip T="string" Color="Color.Info" Label="true" Style="padding: 0.2rem; position: absolute; top: 0; left: 0; height: auto; z-index: 1;" Size="AppStateStatic.Size">
                @Media?.release_date?.Year
            </MudChip>
        }
        else
        {
            <MudChip T="string" Color="Color.Info" Label="true" Style="padding: 0.2rem; position: absolute; top: 0; left: 0; height: auto; z-index: 1;" Size="AppStateStatic.Size">
                @Media?.release_date?.ToShortDateString()
            </MudChip>
        }
        <MudImage Src="@(Media?.poster_large ?? "images/no-image.webp")" Alt="@Media?.title" FallbackSrc="images/no-image.webp" Fluid="true" ObjectFit="ObjectFit.Contain"></MudImage>
    </div>
    <div>
        @if (Media?.runtime != null && Media.runtime > 0)
        {
            <CustomChip Name="@Translations.Module.Media.Duration" Value="@Media.runtime.FormatRuntime()" ColorName="Color.Info" ColorValue="Color.Info"></CustomChip>
        }
        <CustomChips Name="@Translations.Module.Media.Genres" Values="@Media?.Genres" ColorName="Color.Info" ColorValue="Color.Info" Class="ms-2"></CustomChips>
        <div>
            <RenderControl State="State" LoadingHeight="40px" HideIfEmpty="true">

                <CustomChip Name="@Translations.Module.Media.Ratings" TValue="string" ColorName="Color.Info"></CustomChip>

                <CustomChip Value="@RatingsCache?.Data?.imdb" ColorValue="GetColorByRating(RatingsCache?.Data?.imdb)" Tooltip="IMDb" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(RatingsCache?.Data?.imdbLink))" Image="logo/imdb.png" ImageStyle="height: 20px;"></CustomChip>

                <CustomChip Value="@RatingsCache?.Data?.tmdb" ColorValue="GetColorByRating(RatingsCache?.Data?.tmdb)" Tooltip="TMDB" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(RatingsCache?.Data?.tmdbLink))" Image="logo/tmdb.png" ImageStyle="height: 20px;"></CustomChip>

                <CustomChip Value="@RatingsCache?.Data?.metacritic" ColorValue="GetColorByRating(RatingsCache?.Data?.metacritic)" Tooltip="Metacritic" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(RatingsCache?.Data?.metacriticLink))" Image="logo/metacritic.png" ImageStyle="height: 20px;"></CustomChip>

                <CustomChip Value="@RatingsCache?.Data?.trakt" ColorValue="GetColorByRating(RatingsCache?.Data?.trakt)" Tooltip="Trakt" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(RatingsCache?.Data?.traktLink))" Image="logo/trakt.png" ImageStyle="height: 20px;"></CustomChip>

                <CustomChip Value="@RatingsCache?.Data?.rottenTomatoes" ColorValue="GetColorByRating(RatingsCache?.Data?.rottenTomatoes)" Tooltip="Rotten Tomatoes" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(RatingsCache?.Data?.rottenTomatoesLink))" Image="logo/rotten-tomatoes.png" ImageStyle="height: 20px;"></CustomChip>

                <CustomChip Value="@RatingsCache?.Data?.filmAffinity" ColorValue="GetColorByRating(RatingsCache?.Data?.filmAffinity)" Tooltip="Film Affinity" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(RatingsCache?.Data?.filmAffinityLink))" Image="logo/film-affinity.png" ImageStyle="height: 20px;"></CustomChip>

                <CustomChip Value="@RatingsCache?.Data?.letterboxd" ColorValue="GetColorByRating(RatingsCache?.Data?.letterboxd)" Tooltip="Letterboxd" ValueChipClass="mx-0"
                            ValueClick="@(()=>OpenExternalWebsite(RatingsCache?.Data?.letterboxdLink))" Image="logo/letterboxd.png" ImageStyle="height: 20px;"></CustomChip>
               
            </RenderControl>
        </div>
        <MudText Typo="Typo.body1" Align="Align.Justify" Class="@CssHelper.Build().Small("my")">
            @Media?.plot
        </MudText>
        @if (!string.IsNullOrEmpty(Media?.homepage))
        {
            <MudPaper Outlined="true" Class="pa-2 mb-3">
                <MudText Color="Color.Primary" Typo="Typo.subtitle1">
                    @Translations.Module.Media.Homepage
                </MudText>
                <MudDivider Class="mb-2"></MudDivider>
                <MudLink OnClick="@(() => OpenExternalWebsite(Media.homepage))" Color="Color.Secondary" Style="word-break: break-all;">
                    @Media.homepage
                </MudLink>
            </MudPaper>
        }
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.Warning">
            @Translations.Module.Media.PlatformForManaging
        </MudAlert>
    </div>
</MudStack>

@code {
    [Parameter] public MediaDetail? Media { get; set; }
    [Parameter] public string? ImdbId { get; set; }
    [Parameter] public string? TmdbId { get; set; }
    [Parameter] public string? EnglishTitle { get; set; }
    [Parameter] public MediaType? Type { get; set; }

    [Parameter] public WatchingList? Watching { get; set; }
    [Parameter] public WishList? Wish { get; set; }

    [Parameter][EditorRequired] public RenderControlState<RatingsCache> State { get; set; }
    [Parameter] public RatingsCache? RatingsCache { get; set; }

    private Color GetColorByRating(string? rating)
    {
        if (string.IsNullOrEmpty(rating)) return Color.Default;

        float.TryParse(rating.Replace(",", "."), NumberStyles.Any, CultureInfo.InvariantCulture, out var val);

        if (val >= 7.95f)
        {
            return Color.Success;
        }

        if (val >= 5.95f)
        {
            return Color.Warning;
        }

        return Color.Error;
    }

}
