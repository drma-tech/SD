@using SD.Shared.Models.List.Tmdb
@inherits ComponentParameterCore<KeywordsComponent>

@inject TmdbSearchKeywordApi TmdbSearchKeywordApi

<RenderControl State="State" Context="ctx">
    @foreach (var item in List)
    {
        <MudChip T="string" Color="Color.Info" Size="AppStateStatic.Size" Href="@($"/{Culture}/search?keyword={item.id}")">
            @item.name
        </MudChip>
    }
</RenderControl>

@code {
    [Parameter][EditorRequired] public string? Culture { get; set; }
    [Parameter][EditorRequired] public string? TmdbId { get; set; }
    [Parameter][EditorRequired] public MediaType? Type { get; set; }

    private RenderControlState<IReadOnlyCollection<TmdbResultKeyword>> State { get; set; } = new(lst => lst == null || lst.Empty());

    private IReadOnlyCollection<TmdbResultKeyword> List { get; set; } = [];

    protected override List<string?> GetParameterKey()
    {
        return [
            Type.ToString(),
            TmdbId
        ];
    }

    protected override async Task LoadParameterDataAsync()
    {
        await State.StartLoading.Invoke(null);
        if (Type == MediaType.movie)
            List = await TmdbSearchKeywordApi.GetMovieKeywords(TmdbId, Cts.Token);
        else
            List = await TmdbSearchKeywordApi.GetSerieKeywords(TmdbId, Cts.Token);
        await State.FinishLoading.Invoke(List);
    }
}
