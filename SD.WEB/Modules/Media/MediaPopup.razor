@using SD.WEB.Modules.Media.Components
@using SD.WEB.Modules.Profile.Core
@using SD.WEB.Modules.Collections.Core
@inherits ComponentParameterCore<MediaPopup>

@inject TmdbApi TmdbApi
@inject CacheRatingsApi CacheRatingsApi
@inject ExternalIdApi ExternalIdApi
@inject WatchingListApi WatchingListApi
@inject WishListApi WishListApi

<MudDialog Style="width: 100%">
    <DialogContent>
        <RenderControl Actions="Actions">
            <MudTabs Border="true" Outlined="true" TabPanelsClass="pt-2" MinimumTabWidth="100px">
                <MudTabPanel Tag="@Translations.Module.Media.TabAbout" Text="@Translations.Module.Media.TabAbout">
                    <MediaAbout ImdbId="@ImdbId" TmdbId="@TmdbId" Media="@Media" EnglishTitle="@EnglishTitle" Watching="Watching" Wish="Wish" Type="Type"
                                Actions="RatingsActions" RatingsCache="_ratingsCache"></MediaAbout>
                </MudTabPanel>
                <MudTabPanel Tag="@Translations.Module.Media.TabPlatforms" Text="@Translations.Module.Media.WhereToWatch">
                    <MediaWhereToWatch TmdbId="@TmdbId" Type="@Type" ReleaseDate="@Media?.release_date"></MediaWhereToWatch>
                </MudTabPanel>
                <MudTabPanel Tag="@("Collections")" Text="@(Media?.MediaType == MediaType.movie ? Translations.Module.Media.TabCollection1 : Translations.Module.Media.TabCollection2)"
                             Visible="@(Media?.Collection.Any() ?? false)">
                    <MediaCollectionComponent Culture="@Culture" Type="@Type" Media="@Media" Wish="@Wish" TmdbId="@TmdbId"></MediaCollectionComponent>
                </MudTabPanel>
                <MudTabPanel Tag="@("Trailers")" Text="Videos" Visible="@(Media != null && Media.Videos.Any())">
                    @foreach (var group in Media?.Videos.GroupBy(g => g.type).Select(s => s.Key) ?? [])
                    {
                        <MudPaper Outlined="true" Class="pa-2 mb-2">
                            <MudText Color="Color.Primary" Typo="Typo.subtitle1">
                                @group
                            </MudText>
                            <MudDivider Class="mb-2"></MudDivider>
                            <MudStack Row="true" Spacing="@CssHelper.SpaceSmall" Wrap="Wrap.Wrap">
                                @foreach (var item in Media?.Videos.Where(w => w.type == group).Take(10) ?? [])
                                {
                                    <div>
                                        <MudIcon Icon="@Icons.Custom.Brands.YouTube" Color="Color.Primary" Style="vertical-align: top;"></MudIcon>
                                        <MudLink OnClick="@(() => VideoClick(item))" Color="Color.Secondary"
                                                 Style="@((AppStateStatic.Size == Size.Small ? "font-size: 0.8rem !important;" : "font-size: 1rem !important;"))">
                                            @item.name
                                        </MudLink>
                                    </div>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                </MudTabPanel>
                <MudTabPanel Tag="@Translations.Module.Media.TabCredits" Text="@Translations.Module.Media.TabCredits">
                    <CreditsComponent TmdbId="@TmdbId" Type="@Type" WatchingList="Watching" WishList="Wish" Culture="@Culture">
                    </CreditsComponent>
                </MudTabPanel>
                <MudTabPanel Tag="@("Reviews")" Text="Reviews">
                    <ReviewComponent ImdbId="@ImdbId" EnglishTitle="@EnglishTitle?.RemoveSpecialCharacters().RemoveDiacritics().Replace(" ", "-").ToLower()"
                                     Type="@Type" ReleaseDate="@Media?.release_date">
                    </ReviewComponent>
                </MudTabPanel>
            </MudTabs>
        </RenderControl>
    </DialogContent>
    <DialogActions>
        @if (AppStateStatic.IsAuthenticated)
        {
            @if (Wish?.Movies.Any(a => a.id == TmdbId) ?? false)
            {
                <MudButton Color="Color.Error" OnClick="@Remove">
                    @Translations.Button.RemoveWishlist
                </MudButton>
            }
            else if (Wish?.Shows.Any(a => a.id == TmdbId) ?? false)
            {
                <MudButton Color="Color.Error" OnClick="@Remove">
                    @Translations.Button.RemoveWishlist
                </MudButton>
            }
            else
            {
                <MudButton Color="Color.Primary" OnClick="@Add" Disabled="!AppStateStatic.IsAuthenticated">
                    @Translations.Button.AddWishlist
                </MudButton>
            }

            @if (Watching?.Contains(Type, Watching.GetItem(Type, TmdbId ?? "")) ?? false)
            {
                <MudButton Color="Color.Error" OnClick="@IsNotWatched">
                    @Translations.Button.Unfollow
                </MudButton>
            }
            else
            {
                <MudButton Color="Color.Primary" OnClick="@IsWatched" Disabled="!AppStateStatic.IsAuthenticated">
                    @Translations.Button.Follow
                </MudButton>
            }
        }
        <MudButton OnClick="@(() => { MudDialog?.Close(); })">
            @Translations.Button.Close
        </MudButton>
    </DialogActions>
</MudDialog>