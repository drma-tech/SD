@page "/{culture}/help/faq"
@inherits PageCore<FaqPage>

<HeadComponent Title="FAQ" Url=@($"/{Culture}/help/faq") Description="@($"Find answers to common questions about {AppInfo.Title}, including accounts, lists, recommendations, subscriptions, and platform usage.")" Index="false"></HeadComponent>
<PageSectionComponent IsPageHeader="true" Title="FAQ" Description="@($"Find answers to common questions about {AppInfo.Title}, including accounts, lists, recommendations, subscriptions, and platform usage.")"></PageSectionComponent>

<MudExpansionPanels Outlined="true" Elevation="0" Class="@CssHelper.Build().Medium("mb")">
    <MudExpansionPanel Disabled="true" HideIcon="true">
        <TitleContent>
            <div class="d-flex">
                <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.PrivacyTip" class="@CssHelper.Build().Small("mr")"></MudIcon>
                <MudText Color="Color.Primary">Privacy & Data</MudText>
            </div>
        </TitleContent>
    </MudExpansionPanel>
    <MudExpansionPanel Text="What user data does the platform collect?" HeaderClass="mud-secondary-text">
        We collect limited information, including your email address, platform preferences, and usage data such as your IP address and login timestamps. We do not collect sensitive personal information.
    </MudExpansionPanel>
    <MudExpansionPanel Text="Are my lists and data shared with others?" HeaderClass="mud-secondary-text">
        Private lists you create are visible only to you unless you choose to share a public link. Public lists are curated by the platform and accessible to all users.
    </MudExpansionPanel>
</MudExpansionPanels>

<MudExpansionPanels Outlined="true" Elevation="0" Class="@CssHelper.Build().Medium("mb")">
    <MudExpansionPanel Disabled="true" HideIcon="true">
        <TitleContent>
            <div class="d-flex">
                <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.ListAlt" class="@CssHelper.Build().Small("mr")"></MudIcon>
                <MudText Color="Color.Primary">Lists & Recommendations</MudText>
            </div>
        </TitleContent>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Can I create and manage my own lists?" HeaderClass="mud-secondary-text">
        Yes, you can create private lists of movies and TV shows you want to follow or watch. Premium users get higher limits for saved items.
    </MudExpansionPanel>
    <MudExpansionPanel Text="How do personalized recommendations work?" HeaderClass="mud-secondary-text">
        Recommendations are based on your favorite platforms and genres, excluding titles already on other personal lists.
    </MudExpansionPanel>
    <MudExpansionPanel Text="Can I share my private lists?" HeaderClass="mud-secondary-text">
        Yes, you can generate public links to share your private lists with others outside the platform.
    </MudExpansionPanel>
</MudExpansionPanels>

<MudExpansionPanels Outlined="true" Elevation="0" Class="@CssHelper.Build().Medium("mb")">
    <MudExpansionPanel Disabled="true" HideIcon="true">
        <TitleContent>
            <div class="d-flex">
                <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.AccountCircle" class="@CssHelper.Build().Small("mr")"></MudIcon>
                <MudText Color="Color.Primary">Account & Access</MudText>
            </div>
        </TitleContent>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Do I need to create an account?" HeaderClass="mud-secondary-text">
        No account is required to browse public lists and general content. Creating an account lets you save your preferences and manage your personal lists.
    </MudExpansionPanel>
    <MudExpansionPanel Text="What information is required to register?" HeaderClass="mud-secondary-text">
        An email address is required to create an account. We also collect limited technical and usage information, as described in our Privacy Policy.
    </MudExpansionPanel>
    <MudExpansionPanel Text="Can I delete my account and data?" HeaderClass="mud-secondary-text">
        Yes, you can delete your account at any time, which removes your saved lists and preferences from our system.
    </MudExpansionPanel>
</MudExpansionPanels>

<MudExpansionPanels Outlined="true" Elevation="0" Class="@CssHelper.Build().Medium("mb")">
    <MudExpansionPanel Disabled="true" HideIcon="true">
        <TitleContent>
            <div class="d-flex">
                <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.Payment" class="@CssHelper.Build().Small("mr")"></MudIcon>
                <MudText Color="Color.Primary">Subscriptions & Payments</MudText>
            </div>
        </TitleContent>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Is the platform free?" HeaderClass="mud-secondary-text">
        Yes, basic access is free. Premium subscriptions offer benefits such as an ad-free experience and higher limits for saved items.
    </MudExpansionPanel>
    <MudExpansionPanel Text="How do I manage my subscription?" HeaderClass="mud-secondary-text">
        You can manage or cancel your subscription through the payment provider or platform you used to subscribe.
    </MudExpansionPanel>
    <MudExpansionPanel Text="How is payment processed?" HeaderClass="mud-secondary-text">
        Payments are processed securely by our payment partners or platform operators. We do not store full payment details on our servers.
    </MudExpansionPanel>
</MudExpansionPanels>

<MudExpansionPanels Outlined="true" Elevation="0" Class="@CssHelper.Build().Medium("mb")">
    <MudExpansionPanel Disabled="true" HideIcon="true">
        <TitleContent>
            <div class="d-flex">
                <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.HelpOutline" class="@CssHelper.Build().Small("mr")"></MudIcon>
                <MudText Color="Color.Primary">Usage & Support</MudText>
            </div>
        </TitleContent>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Is this a platform to watch movies and shows?" HeaderClass="mud-secondary-text">
        No, our platform is for managing, discovering, and organizing movies and shows, not streaming or viewing content.
    </MudExpansionPanel>
    <MudExpansionPanel Text="How can I contact support?" HeaderClass="mud-secondary-text">
        You can contact support via the in-app feedback section or by emailing support@streamingdiscovery.com.
    </MudExpansionPanel>
    <MudExpansionPanel Text="What languages does the platform support?" HeaderClass="mud-secondary-text">
        The platform interface supports English, Portuguese, and Spanish. Movie and show metadata is available in multiple languages but does not affect site language.
    </MudExpansionPanel>
</MudExpansionPanels>
