@page "/{culture}/auth/register-user"
@inherits PageCore<RegisterUserPage>

@inject LoginApi LoginApi
@inject PrincipalApi PrincipalApi
@inject IpInfoApi IpInfoApi

<HeadComponent Title="Register User" Description="Register User" Url=@($"/{Culture}/auth/register-user") Index="false"></HeadComponent>

@if (AppStateStatic.IsAuthenticated)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="@CssHelper.Build().Raw("mb-20")">
        @if (AppStateStatic.Principal == null)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                <MudText Typo="Typo.h1" Color="Color.Primary" Class="@CssHelper.Build().Large("mb")" Style="font-size: 23px !important; line-height: 1.6 !important;" Align="Align.Center">
                    @Translations.Module.Auth.CreateAccount
                </MudText>

                <MudCheckBox @bind-Value="_terms1" Color="Color.Primary" Class="@CssHelper.Build().Small("mb")">
                    <MudText Inline="true">
                        @((MarkupString)string.Format(Translations.Module.Auth.Terms1, $"<a href='/{Culture}/legal/terms' target='_blank' rel='noopener' class='mud-link mud-primary-text mud-link-underline-hover'>{Translations.Module.Legal.TermsUse}</a>", $"<a href='/{Culture}/legal/privacy' target='_blank' rel='noopener' class='mud-link mud-primary-text mud-link-underline-hover'>{Translations.Module.Legal.PrivacyPolicy}</a>"))
                    </MudText>
                </MudCheckBox>
                <MudCheckBox @bind-Value="_terms2" Color="Color.Primary" Class="@CssHelper.Build().Small("mb")">
                    <MudText Inline="true">
                        @Translations.Module.Auth.Terms2
                    </MudText>
                </MudCheckBox>

                <div style="display: flex;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAccount" Disabled="(!_terms1 || !_terms2)" Class="@CssHelper.Build().Large("mt").Raw("me-2")">
                        @Translations.Button.Confirm
                    </MudButton>
                    <MudSpacer></MudSpacer>
                    <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="Logout" Class="@CssHelper.Build().Large("mt")">
                        @Translations.Button.Cancel / @Translations.Button.Logout
                    </MudButton>
                </div>
            </MudPaper>
        }
        else
        {
            <MudAlert Variant="Variant.Filled" Severity="Severity.Warning" Dense="true" Icon="@IconsFA.Solid.Icon("spinner").Animation(IconAnimation.Spin).Font">
                @Translations.Module.Auth.AuthenticationInProgress
            </MudAlert>
        }
    </MudContainer>
}