@page "/{culture}/popular/{type}"

@inherits PageCore<PopularPage>

@inject ImdbPopularApi ImdbPopularApi
@inject WatchingListApi WatchingApi
@inject WishListApi WishApi

<HeadComponent Title="@($"{Translations.Module.Media.Popular} ({EnumType?.GetFieldSettings().Name})")"
               Description="@Translations.Description.PopularIndex.CustomFormat(EnumType?.GetFieldSettings().Name)" Url="@($"/{Culture}/popular/{Type}")" Index="true" Shared="true" />

@if (EnumType == null)
{
    <NotFoundComponent></NotFoundComponent>
}
else
{
    <PageSectionComponent IsPageHeader="true" Title="@($"{Translations.Module.Media.Popular} ({EnumType.Value.GetFieldSettings().Name})")"
                          Description="@Translations.Description.PopularIndex.CustomFormat(EnumType.Value.GetFieldSettings().Name)" UrlShare="@($"/{Culture}/popular/{Type}")" />

    if (EnumType.Value == PopularType.Movie)
    {
        <MediaListFull MediaListApi="ImdbPopularApi" IsImdb="true" OnlyYear="true" Watching="Watching" Wish="Wish" StringParameters="Params" TypeSelected="MediaType.movie"
                       FullPage="true" ShowHead="false" Culture="@Culture">
        </MediaListFull>
    }
    else
    {
        <MediaListFull MediaListApi="ImdbPopularApi" IsImdb="true" OnlyYear="true" Watching="Watching" Wish="Wish" StringParameters="Params" TypeSelected="MediaType.tv"
                       FullPage="true" ShowHead="false" Culture="@Culture">
        </MediaListFull>
    }
}

@code {
    [Parameter] public string? Type { get; set; }

    public PopularType? EnumType => Type.ParseToEnumNullable<PopularType>();

    public WatchingList? Watching { get; set; }
    public WishList? Wish { get; set; }

    public Dictionary<string, string> Params { get; set; } = new() { { "mode", "full" } };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        WatchingApi.DataChanged += async model => { Watching = model; await InvokeAsync(StateHasChanged); };
        WishApi.DataChanged += async model => { Wish = model; await InvokeAsync(StateHasChanged); };
    }
}
