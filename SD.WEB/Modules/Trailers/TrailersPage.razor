@page "/{culture}/trailers"
@using SD.Shared.Models.Trailers
@inherits PageCore<TrailersPage>

@inject CacheYoutubeApi CacheYoutubeApi

<HeadComponent Title="@Translations.Title.Trailers" Description="@Translations.Description.Trailers" Url=@($"/{Culture}/trailers") Index="true" Shared="true"></HeadComponent>
<PageSectionComponent IsPageHeader="true" Title="@Translations.Title.Trailers" Description="@Translations.Description.Trailers" UrlShare="@($"/{Culture}/trailers")"></PageSectionComponent>

<RenderControl State="State">
    <div class="grid-relative-container-trailer">
        @foreach (var item in TrailerModel?.Data?.Items ?? [])
        {
            <MudLink Href="@($"/{Culture}/video/{($"{item.id}|{item.title}".SimpleEncrypt())}")" rel="nofollow">
                <MudCard Outlined="true">
                    <MudCardContent Style="padding: 0; position: relative;">
                        <MudImage Src="@item?.url" Alt="@item?.title" FallbackSrc="images/no-image.webp" Style="width: 100%;"></MudImage>
                        <MudChip T="string" Label="true" Color="Color.Secondary" Class="poster-chip" Style="top: 0; left: 0; position: absolute; opacity: 0.8;" Size="AppStateStatic.Size">
                            @item?.DateTime.Humanize()
                        </MudChip>
                        @if (item?.Popular ?? false)
                        {
                            <MudTooltip Text="Popular" RootStyle="position: absolute; height: 24px; width: 24px; right: 0;">
                                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Secondary" Style="top: 0; right: 0; position: absolute;" Size="AppStateStatic.Size"></MudIcon>
                            </MudTooltip>
                        }
                    </MudCardContent>
                    <MudCardContent Style="text-align: center; padding: 4px;">
                        <MudText Typo="Typo.h2" Class="custom-title-list">
                            @item.title
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudLink>
        }
    </div>
</RenderControl>

<FloatingButton Template="Template.Back"></FloatingButton>

@code {
    public RenderControlState<YoutubeCache?> State { get; set; } = new(null, obj => obj?.Data == null || obj.Data.Items.Empty());
    private YoutubeCache? TrailerModel { get; set; }

    protected override async Task LoadStaticDataAsync()
    {
        TrailerModel = await CacheYoutubeApi.GetTrailers("full", State, Cts.Token);
    }

}