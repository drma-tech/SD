@using SD.Shared.Models.Trailers
@inherits ComponentCore<TrailersComponent>

@inject CacheYoutubeApi CacheYoutubeApi

<PageSectionComponent Title="@Translations.Title.Trailers" Description="@Translations.Description.TrailersShort">
    <BodyFragment>
        <MudTabs KeepPanelsAlive="true" MinimumTabWidth="60px" ApplyEffectsToContainer="true" TabPanelsClass="@CssHelper.Build().Small("pt")">
            <Header>
                <MudTooltip Text="Expand">
                    <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" Color="Color.Primary" Href=@($"/{Culture}/trailers") />
                </MudTooltip>
            </Header>
            <ChildContent>
                <MudTabPanel Text="All">
                    <RenderControl State="State">
                        <div id="@_gallerySwiperId" class="splide" role="group">
                            <div class="splide__arrows">
                                <button class="splide__arrow splide__arrow--prev">
                                    <MudIcon Icon="@IconsFA.Solid.Icon("circle-chevron-right").Font" Color="Color.Primary" Style="font-size: 30px;"></MudIcon>
                                </button>
                                <button class="splide__arrow splide__arrow--next">
                                    <MudIcon Icon="@IconsFA.Solid.Icon("circle-chevron-right").Font" Color="Color.Primary" Style="font-size: 30px;"></MudIcon>
                                </button>
                            </div>
                            <div class="splide__track">
                                <ul class="splide__list">
                                    @foreach (var item in TrailerModel?.Data?.Items ?? [])
                                    {
                                        <li class="splide__slide">
                                            <div class="swiper-slide" style="width: 190px; height: 160px;">
                                                <MudLink OnClick="() => VideoClick(item)" rel="nofollow">
                                                    <MudCard Outlined="true" Style="height: 100%;">
                                                        <MudCardContent Style="padding: 0;">
                                                            <MudImage Src="@item?.url" Alt="@item?.title" FallbackSrc="images/no-image.webp" Style="width: 100%;" ObjectFit="ObjectFit.Contain"></MudImage>
                                                            <MudChip T="string" Label="true" Color="Color.Secondary" Class="poster-chip" Style="top: 0; left: 0; position: absolute; opacity: 0.8;" Size="AppStateStatic.Size">
                                                                @item?.DateTime.Humanize()
                                                            </MudChip>
                                                            @if (item?.Popular ?? false)
                                                            {
                                                                <MudTooltip Text="Popular" RootStyle="position: absolute; height: 24px; width: 24px; right: 0;">
                                                                    <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Secondary" Style="top: 0; right: 0; position: absolute;" Size="AppStateStatic.Size"></MudIcon>
                                                                </MudTooltip>
                                                            }
                                                        </MudCardContent>
                                                        <MudCardContent Style="text-align: center; padding: 4px;" Class="@($"custom-title-list {(item?.Popular == true ? "mud-secondary-text" : "")}")">
                                                            @item?.title
                                                        </MudCardContent>
                                                    </MudCard>
                                                </MudLink>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </RenderControl>
                </MudTabPanel>
            </ChildContent>
        </MudTabs>
    </BodyFragment>
</PageSectionComponent>

@code {
    [Parameter][EditorRequired] public string? Culture { get; set; }

    public RenderControlState<YoutubeCache?> State { get; set; } = new(null, obj => obj?.Data == null || obj.Data.Items.Empty());
    private YoutubeCache? TrailerModel { get; set; }

    private readonly string _gallerySwiperId = $"swiper-trailer-{Guid.NewGuid()}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JsRuntime.Slider().InitTrailers(_gallerySwiperId, Cts.Token);

            await base.OnAfterRenderAsync(firstRender);
        }
        catch (Exception ex)
        {
            await ProcessException(ex);
        }
    }

    protected override async Task LoadStaticDataAsync()
    {
        TrailerModel = await CacheYoutubeApi.GetTrailers("compact", State, Cts.Token);
    }

    private void VideoClick(TrailerModelItem item)
    {
        Navigation.NavigateTo($"/{Culture}/video/{($"{item.id}|{item.title}".SimpleEncrypt())}");
    }

}