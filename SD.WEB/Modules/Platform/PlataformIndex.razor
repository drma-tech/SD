@page "/{culture}/platforms"
@page "/{culture}/platforms/{region}"

@using Microsoft.AspNetCore.Components.Authorization
@using SD.WEB.Modules.Platform.Core
@using SD.WEB.Modules.Profile.Core
@using SD.WEB.Modules.Subscription.Core
@inherits PageParameterCore<PlataformIndex>

@inject AllProvidersApi AllProvidersApi
@inject MyProvidersApi MyProvidersApi
@inject IpInfoApi IpInfoApi

@if (isNotFound)
{
    <NotFoundComponent></NotFoundComponent>
}
else
{
    <HeadComponent Title="@(Translations.Title.Providers.CustomFormat(RegionEnum?.GetFieldSettings().Name ?? "invalid country"))"
                   Description="@Translations.Description.Platforms.CustomFormat(RegionEnum?.GetFieldSettings().Name ?? "invalid country")" Url=@($"/{Culture}/platforms/{Region}")
                   Index="@Region.NotEmpty()" Shared="true" FixedAlternateLanguage="@Culture"></HeadComponent>

    <PageSectionComponent IsPageHeader="true" Title="@(Translations.Title.Providers.CustomFormat(RegionEnum?.GetFieldSettings().Name ?? "invalid country"))"
                          Description="@Translations.Description.Platforms.CustomFormat(RegionEnum?.GetFieldSettings().Name ?? "invalid country")">
        <ActionsFragment>
            <MudSelect T="DeliveryModel?" @bind-Value="@DeliveryModel" Clearable="true" FitContent="true" Style="min-width: 150px;" Label="@Translations.Module.Media.DeliveryModel" Dense="true" Class="me-2">
                @foreach (var item in DeliveryModels)
                {
                    <MudSelectItem T="DeliveryModel?" Value="@item.Value">
                        @item.Name
                    </MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="MediaType?" @bind-Value="@MediaType" Clearable="true" FitContent="true" Style="min-width: 150px;" Label="@Translations.Module.Media.MediaType" Dense="true" Class="me-2">
                @foreach (var item in MediaTypes)
                {
                    <MudSelectItem T="MediaType?" Value="@item.Value">
                        @item.Name
                    </MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" Label="@Translations.Module.Media.Name" @bind-Value="@name" Clearable="true" Variant="Variant.Text" Immediate="true" Style="max-width: 180px;"></MudTextField>
        </ActionsFragment>
    </PageSectionComponent>

    <RenderControl State="State" LoadingHeight="260px">
        @if (GetFilteredProviders(ShowAll).Any())
        {
            <div class="grid-relative-container-platform">
                @foreach (var item in GetFilteredProviders(ShowAll))
                {
                    var favorite = MyProviders?.Items.Any(a => a.id == item.id) ?? false;

                    <div>
                        <MudCard Outlined="true" Style="height: 100%;">
                            <MudCardHeader Style="padding: 8px;">
                                <CardHeaderAvatar>
                                    <MudLink Href="@($"/{Culture}/platform/{item.id}")">
                                        <MudAvatar Size="Size.Large">
                                            <MudImage Src="@(TmdbOptions.OriginalPosterPath + item.logo_path)" Alt="@item.name" FallbackSrc="images/no-image.webp"></MudImage>
                                        </MudAvatar>
                                    </MudLink>
                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <CustomChip Name="@item.name" TValue="string" ColorName="Color.Primary" Size="Size.Medium" NameHref="@($"/{Culture}/platform/{item.id}")"></CustomChip>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Class="py-1 px-2">
                                <CustomChips Name="@Translations.Module.Media.DeliveryModel" Values="item.models.Select(m => m.GetFieldSettings().Name)"
                                             Size="Size.Small" Style="display: block;" ColorName="Color.Secondary"></CustomChips>
                                <CustomChips Name="@Translations.Module.Media.MediaType" Values="item.types.Select(m => m.GetFieldSettings().Name)"
                                             Size="Size.Small" Style="display: block;" ColorName="Color.Secondary"></CustomChips>
                                <CustomChip Name="@Translations.Module.Media.Countries" Value="@item.regions.Count"
                                            Size="Size.Small" Style="display: block;" ColorName="Color.Secondary"></CustomChip>
                            </MudCardContent>
                            <MudCardActions Style="padding: 4px;">
                                @if (favorite)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Star" Color="Color.Success" OnClick="@(() => Remove(item))" />
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Star" Color="Color.Default" OnClick="@(() => Add(item))" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Share" Color="Color.Default" OnClick="@(() => ShareClick(item))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Link" Color="Color.Primary" Href="@($"/{Culture}/platform/{item.id}")" />
                            </MudCardActions>
                        </MudCard>
                        <AuthorizeView Roles="administrator" Context="ctx">
                            <Authorized>
                                @*  @if (string.IsNullOrEmpty(item.link))
                                {
                                    <p class="m-0" style="color: red">link</p>
                                } *@
                                        @*  @if (string.IsNullOrEmpty(item.description))
                                {
                                    <p class="m-0" style="color: red">description</p>
                                } *@
                                @if (item.models.Empty())
                                {
                                    <p class="m-0" style="color: red">model</p>
                                }
                                @*  @if (item.models.Any(a => a == SD.Shared.Enums.DeliveryModel.SVOD) && item.plans.Empty())
                                {
                                    <p class="m-0" style="color: red">plan</p>
                                } *@
                            </Authorized>
                        </AuthorizeView>
                    </div>
                }
            </div>
            <div style="text-align: center;" class="@CssHelper.Build().Small("pt").Large("mb")">
                <MudButton StartIcon="@Icons.Material.Filled.ExpandMore" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ShowAll = true)"
                           Disabled="@(ShowAll || AllProviders == null || GetFilteredProviders(true).Count() == GetFilteredProviders(false).Count())">
                    @Translations.Button.LoadMore
                </MudButton>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Warning"
                      Class="@CssHelper.Build().Large("mb")" Style="text-align: justify; width: 100%;">
                @Translations.Notification.RenderControlNoData
            </MudAlert>
        }
    </RenderControl>
}

<style>
    .mud-card-header .mud-card-header-avatar {
        margin-right: 8px;
        margin-inline-end: 8px;
    }

    .mud-chip > .mud-chip-content {
        white-space: break-spaces;
    }
</style>