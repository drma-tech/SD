@using SD.WEB.Modules.Profile.Core
@using SD.WEB.Modules.Collections.Core
@inherits ComponentCore<CollectionPopup>

@inject TmdbApi TmdbApi
@inject WatchingListApi WatchingListApi
@inject WishListApi WishListApi

<MudDialog Style="width: 100%">
    <DialogContent>
        <RenderControl State="State">
            <div class="grid-relative-container-poster mb-2">
                @foreach (var item in GetMediaDetails())
                {
                    <NewPosterComponent MediaDetail="@item" ShowWished="Type == MediaType.movie" WishList="Wish" WatchingList="Watching" Clicked="@OpenPopupMedia">
                    </NewPosterComponent>
                }
            </div>
        </RenderControl>
    </DialogContent>
    <DialogActions>
        @if (AppStateStatic.IsAuthenticated && !Franchise)
        {
            <MudButton Color="Color.Primary" OnClick="@IsWatched">
                @Translations.Button.Update
            </MudButton>
            <MudButton Color="Color.Error" OnClick="@RemoveCollection">
                @Translations.Button.RemoveCollection
            </MudButton>
        }
        <MudButton OnClick="@(() => { MudDialog?.Close(); })">
            @Translations.Button.Close
        </MudButton>
    </DialogActions>
</MudDialog>