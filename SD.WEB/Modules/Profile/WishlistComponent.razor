@inherits ComponentCore<WishlistComponent>

<PageSectionComponent Title="@Translations.Module.Profile.Wishlist" Description="@Translations.Module.Profile.WishlistDesc" ShowHeader="ShowHeader" Icon="@Icons.Material.Filled.Bookmark">
    <BodyFragment>
        @if (TypeParam.HasValue)
        {
            <RenderControl State="@(TypeParam == MediaType.movie ? MovieState : TvState)" PrivateFeature="true" IsAuthenticated="AppStateStatic.IsAuthenticated">
                @if (FullScreen)
                {
                    <div class="grid-relative-container-poster">
                        @foreach (var item in Items(TypeParam.Value).Take(GetTotalItems) ?? [])
                        {
                            string? logo = null;
                            if (item.logo.NotEmpty() && item.logo.StartsWith("http"))
                            {
                                logo = item.logo;
                            }
                            else
                            {
                                logo = string.IsNullOrEmpty(item.logo) ? "" : TmdbOptions.SmallPosterPath + item.logo;
                            }

                            <PosterComponent Poster="@logo" Title="@item.name" Runtime="item.runtime" TmdbId="@item.id" MediaType="TypeParam.Value"
                                             Clicked="@(async () => await ShowMediaPopup(TypeParam.Value, item.id, item.name))" ShowWished="false" WishList="Wish">
                            </PosterComponent>
                        }
                    </div>
                }
                else
                {
                    <Slider List="Items(TypeParam.Value).Take(GetTotalItems) ?? []" Context="item">
                        @{
                            string? logo = null;
                            if (item.logo.NotEmpty() && item.logo.StartsWith("http"))
                            {
                                logo = item.logo;
                            }
                            else
                            {
                                logo = string.IsNullOrEmpty(item.logo) ? "" : TmdbOptions.SmallPosterPath + item.logo;
                            }
                        }
                        <div style="@($"width: {(AppStateStatic.IsMobile ? "110" : "130")}px")">
                            <PosterComponent Poster="@logo" Title="@item.name" Runtime="item.runtime" TmdbId="@item.id" MediaType="TypeParam.Value"
                                             Clicked="@(async () => await ShowMediaPopup(TypeParam.Value, item.id, item.name))" ShowWished="false" WishList="Wish">
                            </PosterComponent>
                        </div>
                    </Slider>
                }
            </RenderControl>
        }
        else
        {
            <MudTabs KeepPanelsAlive="true" MinimumTabWidth="60px" ApplyEffectsToContainer="true" TabPanelsClass="@CssHelper.Build().Small("pt")"
                     ActivePanelIndexChanged="@((int index) => { if (index == 0) _type = MediaType.movie; else _type = MediaType.tv; })">
                <Header>
                    <MudTooltip Text="Expand">
                        <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" Color="Color.Primary" Disabled="false" OnClick="@(async () => await OpenCompleteList(_type))" />
                    </MudTooltip>
                </Header>
                <ChildContent>
                    <MudTabPanel Text="@MediaType.movie.GetFieldSettings().Name">
                        <RenderControl State="MovieState" PrivateFeature="true" IsAuthenticated="AppStateStatic.IsAuthenticated">
                            @if (FullScreen)
                            {
                                <div class="grid-relative-container-poster">
                                    @foreach (var item in Wish?.Movies.Take(GetTotalItems) ?? [])
                                    {
                                        string? logo = null;
                                        if (item.logo.NotEmpty() && item.logo.StartsWith("http"))
                                        {
                                            logo = item.logo;
                                        }
                                        else
                                        {
                                            logo = string.IsNullOrEmpty(item.logo) ? "" : TmdbOptions.SmallPosterPath + item.logo;
                                        }
                                        <PosterComponent Poster="@logo" Title="@item.name" Runtime="item.runtime" TmdbId="@item.id" MediaType="MediaType.movie"
                                                         Clicked="@(async () => await ShowMediaPopup(MediaType.movie, item.id, item.name))" ShowWished="false" WishList="Wish">
                                        </PosterComponent>
                                    }
                                </div>
                            }
                            else
                            {
                                <Slider List="Wish?.Movies.Take(GetTotalItems) ?? []" Context="item">
                                    @{
                                        string? logo = null;
                                        if (item.logo.NotEmpty() && item.logo.StartsWith("http"))
                                        {
                                            logo = item.logo;
                                        }
                                        else
                                        {
                                            logo = string.IsNullOrEmpty(item.logo) ? "" : TmdbOptions.SmallPosterPath + item.logo;
                                        }
                                    }
                                    <div style="@($"width: {(AppStateStatic.IsMobile ? "110" : "130")}px")">
                                        <PosterComponent Poster="@logo" Title="@item.name" Runtime="item.runtime" TmdbId="@item.id" MediaType="MediaType.movie"
                                                         Clicked="@(async () => await ShowMediaPopup(MediaType.movie, item.id, item.name))" ShowWished="false" WishList="Wish">
                                        </PosterComponent>
                                    </div>
                                </Slider>
                            }
                        </RenderControl>
                    </MudTabPanel>
                    <MudTabPanel Text="@MediaType.tv.GetFieldSettings().Name">
                        <RenderControl State="TvState" PrivateFeature="true" IsAuthenticated="AppStateStatic.IsAuthenticated">
                            @if (FullScreen)
                            {
                                <div class="grid-relative-container-poster">
                                    @foreach (var item in Wish?.Shows.Take(GetTotalItems) ?? [])
                                    {
                                        var logo = string.IsNullOrEmpty(item.logo) ? "" : TmdbOptions.SmallPosterPath + item.logo;
                                        <PosterComponent Poster="@logo" Title="@item.name" Runtime="item.runtime" TmdbId="@item.id" MediaType="MediaType.tv"
                                                         Clicked="@(async () => await ShowMediaPopup(MediaType.tv, item.id, item.name))" ShowWished="false" WishList="Wish">
                                        </PosterComponent>
                                    }
                                </div>
                            }
                            else
                            {
                                <Slider List="Wish?.Shows.Take(GetTotalItems) ?? []" Context="item">
                                    @{
                                        var logo = string.IsNullOrEmpty(item.logo) ? "" : TmdbOptions.SmallPosterPath + item.logo;
                                    }
                                    <div style="@($"width: {(AppStateStatic.IsMobile ? "110" : "130")}px")">
                                        <PosterComponent Poster="@logo" Title="@item.name" Runtime="item.runtime" TmdbId="@item.id" MediaType="MediaType.tv"
                                                         Clicked="@(async () => await ShowMediaPopup(MediaType.tv, item.id, item.name))" ShowWished="false" WishList="Wish">
                                        </PosterComponent>
                                    </div>
                                </Slider>
                            }
                        </RenderControl>
                    </MudTabPanel>
                </ChildContent>
            </MudTabs>
        }
    </BodyFragment>
</PageSectionComponent>