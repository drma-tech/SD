@using SD.WEB.Modules.Profile.Components
@using SD.WEB.Modules.Profile.Core
@inherits ComponentCore<MyWatchingListPopup>

@inject WatchingListApi WatchingApi
@inject WishListApi WishApi

<MudDialog Style="width: 100%">
    <DialogContent>
        <WatchingComponent TypeParam="MediaType" ShowHeader="false" FullScreen="true" Watching="Watching" Wish="Wish"
                           ActionsMovie="Actions" ActionsTv="Actions" Culture="@Culture">
        </WatchingComponent>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => { MudDialog?.Close(); })">
            @Translations.Button.Close
        </MudButton>
    </DialogActions>
</MudDialog>