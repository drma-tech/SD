@inherits ComponentCore<MyWishListPopup>

@inject WatchingListApi WatchingApi
@inject WishListApi WishApi

<MudDialog Style="width: 100%">
    <DialogContent>
        <WishlistComponent TypeParam="MediaType" ShowHeader="false" FullScreen="true" Watching="Watching" Wish="Wish"
                           MovieState="State" TvState="State" Culture="@Culture">
        </WishlistComponent>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => { MudDialog?.Close(); })">
            @Translations.Button.Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter][EditorRequired] public RenderControlState<WishList>? State { get; set; }

    [Parameter][EditorRequired] public WatchingList? Watching { get; set; }
    [Parameter][EditorRequired] public WishList? Wish { get; set; }
    [Parameter][EditorRequired] public string? Culture { get; set; }

    [Parameter] public EventCallback<WatchingList?> WatchingChanged { get; set; }
    [Parameter] public EventCallback<WishList?> WishChanged { get; set; }
    [Parameter][EditorRequired] public MediaType MediaType { get; set; }

    private string Title => MediaType == MediaType.movie ? Translations.Module.Profile.MyMovieWishlist : Translations.Module.Profile.MySeriesWishlist;
    private int Quantity => MediaType == MediaType.movie ? Wish?.Movies.Count ?? 0 : Wish?.Shows.Count ?? 0;

    protected override void OnInitialized()
    {
        WatchingApi.DataChanged += model =>
        {
            Watching = model;
            WatchingChanged.InvokeAsync(model);
            StateHasChanged();
        };
        WishApi.DataChanged += model =>
        {
            State?.StartLoading?.Invoke(null);
            Wish = model;
            WishChanged.InvokeAsync(model);
            State?.FinishLoading?.Invoke(model);
            StateHasChanged();
        };
    }

}