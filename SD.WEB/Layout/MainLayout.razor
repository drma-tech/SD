@using SD.WEB.Modules.Auth.Core
@using SD.WEB.Modules.Subscription.Core
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Toolbelt.Blazor.PWA.Updater
@inherits LayoutComponentBase

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<MainLayout> Logger
@inject IJSRuntime JsRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject IBrowserViewportService BrowserViewportService

@inject PrincipalApi PrincipalApi
@inject NavigationManager Navigation
@inject IpInfoApi IpInfoApi
@inject LoginApi LoginApi

<MudThemeProvider @ref="_mudThemeProvider" IsDarkMode="@_darkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudMessageBox />
<MudSnackbarProvider Style="top: 60px;" />

<PWAUpdater Text="@Translations.Notification.PWAUpdaterText" ButtonCaption="@Translations.Notification.PWAUpdaterButton" />

<MudLayout>
    <HeadLayout></HeadLayout>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="@CssHelper.Build().Medium("my")">
            @if (ShowAdvertising)
            {
                <Advertising Slot="@AdSlot.Header"></Advertising>
            }
            @Body
            @if (ShowAdvertising)
            {
                <Advertising Slot="@AdSlot.Footer"></Advertising>
            }
        </MudContainer>
        <FooterComponent></FooterComponent>
        <MudDivider Class="@CssHelper.Build().Small("my").Medium("mt")"></MudDivider>
        <MudText Align="Align.Center" Class="@CssHelper.Build().Small("mb")">
            © @AppInfo.Year-@DateTime.Now.Year - DRMA Tech.
        </MudText>
    </MudMainContent>
</MudLayout>