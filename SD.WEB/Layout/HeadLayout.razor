@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop

@inject PaymentPublicApi PaymentPublicApi

@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@inject ILogger<HeadLayout> Logger

@if (_processing)
{
    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Style="position: fixed; z-index: 1400;" />
}
<MudAppBar Fixed="true" Elevation="1" Color="Color.Dark">

    <MudButton StartIcon="@Icons.Material.Filled.House" Color="@GetColor($"/{Culture}")" Href=@($"/{Culture}") Variant="@GetVariant($"/{Culture}")" Class="@menuClass" Disabled="_blockedActions">
        @Translations.Title.Main
    </MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Person" Color="@GetColor($"/{Culture}/profile")" Href=@($"/{Culture}/profile") Variant="@GetVariant($"/{Culture}/profile")" Class="@menuClass" Disabled="_blockedActions" Target="_self" Rel="nofollow">
        @Translations.Title.Profile
    </MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Movie" Color="@GetColor($"/{Culture}/platforms")" Href=@($"/{Culture}/platforms") Variant="@GetVariant($"/{Culture}/platforms")" Class="@menuClass" Disabled="_blockedActions" Rel="nofollow">
        @Translations.Title.Platforms
    </MudButton>

    <MudSpacer />

    @if (!AppStateStatic.IsPremiumUser)
    {
        <MudIconButton Color="Color.Warning" Icon="@IconsFA.Solid.Icon("gem").Animation(IconAnimation.Fade).Font" Style="margin-right: -8px;" OnClick="@OpenSubscription" />
    }

    <MudIconButton Icon="@Icons.Material.Filled.Apps" Color="Color.Inherit" Class="me-1" OnClick="@AppsClick" />

    <AuthorizeView>
        <Authorized>
            <MudAvatar>
                <MudImage Src=@(AppStateStatic.User?.FindFirst(c => c.Type == "avatar")?.Value ?? "images/no-user.webp") onclick="@(() => MenuClick())" Style="cursor: pointer;"></MudImage>
            </MudAvatar>
        </Authorized>
        <NotAuthorized>
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@MenuClick" />
        </NotAuthorized>
    </AuthorizeView>
</MudAppBar>

<MudDrawer @bind-Open="@_openMenu" Anchor="Anchor.Right" Elevation="1" Variant="@DrawerVariant.Temporary" OverlayAutoClose="true" Width="275px">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6" Color="Color.Primary">@AppInfo.Title</MudText>
    </MudDrawerHeader>
    <MudNavMenu>
        <AuthorizeView>
            <Authorized>
                <div style="padding: 8px 16px 8px 16px; display: flex; align-items: center;">
                    <MudAvatar Size="Size.Small" Class="me-3">
                        <MudImage Src=@(AppStateStatic.User?.FindFirst(c => c.Type == "avatar")?.Value ?? "images/no-user.webp")></MudImage>
                    </MudAvatar>
                    <div>
                        <MudText Style="font-size: 14px;">
                            @AppStateStatic.User?.FindFirst(c => c.Type == "name")?.Value
                        </MudText>
                        <MudText Style="font-size: 14px;">
                            @AppStateStatic.User?.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value
                        </MudText>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>

        <MudDivider></MudDivider>

        @if (AppStateStatic.IsPremiumUser)
        {
            <MudNavLink Icon="@Icons.Material.Filled.Diamond" OnClick="@OpenSubscription">
                @Translations.Button.MySubscription
            </MudNavLink>
        }
        else
        {
            <MudNavLink Icon="@Icons.Material.Filled.Diamond" OnClick="@OpenSubscription" IconColor="Color.Warning" Style="color: var(--mud-palette-warning)">
                @Translations.Button.UnlockBenefits
            </MudNavLink>
        }

        <MudDivider></MudDivider>

        <AuthorizeView>
            <Authorized>
                <MudNavLink Icon="@Icons.Material.Filled.VerifiedUser" OnClick="@MyAccount">
                    @Translations.Module.Auth.MyAccount
                </MudNavLink>
            </Authorized>
        </AuthorizeView>
        <MudNavLink Icon="@Icons.Material.Filled.Settings" OnClick="@OpenConfigurations">
            @Translations.Module.Help.Settings
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.HelpCenter" Href=@($"/{Culture}/help")>
            @Translations.Module.Help.HelpTitle
        </MudNavLink>

        <MudDivider></MudDivider>

        <AuthorizeView>
            <Authorized>
                <MudNavLink Icon="@Icons.Material.Filled.Logout" OnClick="@Logout" Disabled="_blockedActions">
                    @Translations.Button.Logout
                </MudNavLink>
            </Authorized>
            <NotAuthorized>
                <MudNavLink Icon="@Icons.Material.Filled.Login" OnClick="Login" Disabled="_blockedActions" IconColor="Color.Secondary" Style="color: var(--mud-palette-secondary)">
                    @Translations.Button.Login
                </MudNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </MudNavMenu>
    <MudSpacer></MudSpacer>
    <MudText Typo="Typo.caption" Align="Align.Center" Class="mb-2">
        @($"{Translations.Notification.Version}: {AppStateStatic.Version}")
    </MudText>
</MudDrawer>

<MudDrawer @bind-Open="@_openApps" Anchor="Anchor.Right" Elevation="1" Variant="@DrawerVariant.Temporary" OverlayAutoClose="true" Width="275px">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6" Color="Color.Primary"> @Translations.Module.Help.MorefromDRMATech</MudText>
    </MudDrawerHeader>
    @foreach (var product in AppInfo.Products)
    {
        <MudDivider Style="flex-grow: unset;"></MudDivider>
        <div style="padding: 8px 16px 0px 16px; display: flex; align-items: center;">
            <MudImage Src=@product.Logo Style="width: 40px;" Class="me-2"></MudImage>
            <div>
                <MudText Style="font-size: 14px;" Color="Color.Secondary">
                    @product.Title
                </MudText>
                <MudText Style="font-size: 14px;" Color="Color.Inherit">
                    @product.SubTitle
                </MudText>
            </div>
        </div>
        <MudLink style="padding: 0px 16px 8px 16px;" Href="@product.Url" Target="_blank" Color="Color.Tertiary">
            @(new Uri(product.Url).Host)
        </MudLink>
    }
</MudDrawer>