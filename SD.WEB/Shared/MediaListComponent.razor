@inherits ComponentParameterCore<MediaListComponent>

@inject ExternalIdApi ExternalIdApi
@inject TmdbCreditApi TmdbCreditApi
@using SD.WEB.Modules.Collections.Core

@if (ContainsHeader)
{
    <PageSectionComponent Title="@Title" Icon="@Icon" Image="@Image" Description="@Description">
        <BodyFragment>
            <MudTabs KeepPanelsAlive="true" MinimumTabWidth="100" ApplyEffectsToContainer="true" TabPanelsClass="@CssHelper.Build().Small("pt")"
                     ActivePanelIndex="@(TypeSelected == MediaType.movie ? 0 : 1)"
                     ActivePanelIndexChanged="@(async (int index) => { TypeSelected = index == 0 ? MediaType.movie : MediaType.tv; await TypeSelectedChangedHandle(TypeSelected); })">
                <Header>
                    <MudTooltip Text="Expand">
                        <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo(GetCustomExpandUrl()))" Disabled="@(List == null && CustomExpand.Empty())" />
                    </MudTooltip>
                </Header>
                <ChildContent>
                    @if (ShowMovieFilter)
                    {
                        <MudTabPanel Text="@MediaType.movie.GetFieldSettings().Name">
                            <RenderControl Actions="Actions">
                                <Slider List="Items" Context="item">
                                    <div style="@($"width: {(AppStateStatic.IsMobile ? "110" : "130")}px")">
                                        <PosterComponent Poster="@item.poster_small" Title="@item.title" Clicked="@(() => OpenPopupMedia(item))" MediaType="@item.MediaType"
                                                         Date="@item.release_date" OnlyYear="OnlyYear" ForceTypoTitle="ForceTypoTitle"
                                                         Rating="@item.rating" WishList="Wish" TmdbId="@item.tmdb_id" Comments="@item.comments" CommentsIsImage="CommentsIsImage">
                                        </PosterComponent>
                                    </div>
                                </Slider>
                            </RenderControl>
                        </MudTabPanel>
                    }
                    @if (ShowTvFilter)
                    {
                        <MudTabPanel Text="@MediaType.tv.GetFieldSettings().Name">
                            <RenderControl Actions="Actions">
                                <Slider List="Items" Context="item">
                                    <div style="@($"width: {(AppStateStatic.IsMobile ? "110" : "130")}px")">
                                        <PosterComponent Poster="@item.poster_small" Title="@item.title" Clicked="@(() => OpenPopupMedia(item))" MediaType="@item.MediaType"
                                                         Date="@item.release_date" OnlyYear="OnlyYear" ForceTypoTitle="ForceTypoTitle"
                                                         Rating="@item.rating" WishList="Wish" TmdbId="@item.tmdb_id" Comments="@item.comments" CommentsIsImage="CommentsIsImage">
                                        </PosterComponent>
                                    </div>
                                </Slider>
                            </RenderControl>
                        </MudTabPanel>
                    }
                </ChildContent>
            </MudTabs>
        </BodyFragment>
    </PageSectionComponent>
}
else
{
    <RenderControl Actions="Actions">
        <Slider List="Items" Context="item">
            <div class="swiper-slide" style="@($"width: {(AppStateStatic.IsMobile ? "110" : "130")}px")">
                <PosterComponent Poster="@item.poster_small" Title="@item.title" Clicked="@(() => OpenPopupMedia(item))" MediaType="@item.MediaType"
                                 Date="@item.release_date" OnlyYear="OnlyYear" ForceTypoTitle="ForceTypoTitle"
                                 Rating="@item.rating" WishList="Wish" TmdbId="@item.tmdb_id" Comments="@item.comments" CommentsIsImage="CommentsIsImage">
                </PosterComponent>
            </div>
        </Slider>
    </RenderControl>
}