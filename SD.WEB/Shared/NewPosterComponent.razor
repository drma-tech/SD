<div>
    <div @onclick="@DivClicked" style="@($"{(Clicked.HasDelegate ? "cursor: pointer;" : "")} position: relative;")">
        <MudImage Src="@(MediaDetail.poster_small ?? "images/no-image.webp")" Alt="@MediaDetail.title" FallbackSrc="images/no-image.webp" Fluid="true" ObjectFit="ObjectFit.Contain" Style="vertical-align: bottom;" />

        @if (TopLeft != null)
        {
            <MudChip T="string" Color="TopLeft.Color" Label="true" Class="poster-chip" Style="top: 0; left: 0;" Icon="@TopLeft.Icon" Size="AppStateStatic.Size">
                @TopLeft.Text
            </MudChip>
        }
        @if (TopRight != null)
        {
            <MudChip T="string" Color="TopRight.Color" Label="true" Class="poster-chip" Style="top: 0; right: 0;" Icon="@TopRight.Icon" Size="AppStateStatic.Size">
                @TopRight.Text
            </MudChip>
        }
        @if (CenterLeft != null)
        {
            <MudChip T="string" Color="CenterLeft.Color" Label="true" Class="poster-icon chip-no-text" Style="left: 0;" Icon="@CenterLeft.Icon" Size="AppStateStatic.Size">
            </MudChip>
        }
        @if (CenterRight != null)
        {
            <MudChip T="string" Color="CenterRight.Color" Label="true" Class="poster-icon chip-no-text" Style="right: 0;" Icon="@CenterRight.Icon" Size="AppStateStatic.Size">
            </MudChip>
        }
        @if (ForceShowTitle)
        {
            <div class="absolute my-1" style="width: 100%; background-color: rgba(255, 255, 255, 0.7); text-align: center; top: 50%; left: 50%; transform: translate(-50%, -50%);">
                <MudText Typo="Typo.h6" Color="Color.Dark" Style="line-height: normal;">
                    @MediaDetail.title
                </MudText>
            </div>
        }
        @if (MediaDetail.comments.NotEmpty())
        {
            if (CommentsIsImage)
            {
                <MudGrid Spacing="0" Justify="Justify.SpaceEvenly" Class="absolute" Style="bottom: 0; background-color: rgba(255, 255, 255, 0.5);">
                    @foreach (var item in MediaDetail.comments!.Split(CommentsSeparator).Where(p => p != "a"))
                    {
                        <MudItem xs="3">
                            <MudTooltip RootClass="tooltip-image" Text="@item">
                                <MudPaper Outlined="true" Class="my-1">
                                    <MudImage Src="@($"logo/{item}.png")" Alt="@item" Fluid="true" ObjectFit="ObjectFit.Contain" Class="rounded-lg" Style="vertical-align: bottom;"></MudImage>
                                </MudPaper>
                            </MudTooltip>
                        </MudItem>
                    }
                </MudGrid>
            }
            else
            {
                <div class="absolute" style="bottom: 0; background-color: rgba(255, 255, 255, 0.5); width: 100%; text-align: center;">
                    @foreach (var item in MediaDetail.comments!.Split(CommentsSeparator))
                    {
                        <MudChip T="string" Color="Color.Secondary" Label="true" Class="poster-chip" Style="bottom: 0; z-index: 1; position: inherit !important;" Size="AppStateStatic.Size">
                            @item
                        </MudChip>
                    }
                </div>
            }
        }
    </div>
    <div style="text-align: center;" class="mt-1">
        <MudText Typo="@(ForceTypoTitle ?? (FullPage ? Typo.h2 : Typo.h3))" Class="custom-title-list">
            @MediaDetail.title
        </MudText>
    </div>
</div>