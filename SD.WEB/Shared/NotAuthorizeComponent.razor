@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@inject ILogger<NotAuthorizeComponent> Logger

@implements IDisposable

<PageTitle>401 - Unauthorized</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<style>
    body {
        margin: 0;
        font-family: sans-serif;
    }

    .container {
        height: calc(100vh - 64px - 32px - 48px - 24px);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }
</style>

<div class="container">
    <div>
        <MudText Typo="Typo.h4" Color="Color.Primary">@Translations.Module.Auth.UnauthenticatedUser</MudText>
        <MudText Typo="Typo.h6">@Translations.Module.Auth.YouMustLogged</MudText>
        <div class="@CssHelper.Build().Large("mt")">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Login" Class="me-3">
                @Translations.Button.Login
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" Href=@($"/{Culture}")>
                Return to the homepage
            </MudButton>
        </div>
    </div>
</div>

@code {
    private string Culture => Navigation.GetCulture();

    protected override void OnInitialized()
    {
        AppStateStatic.HideAdvertising.Publish(true);
    }

    private async Task Login()
    {
        try
        {
            await JsRuntime.Clerk().SignInAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            ex.ProcessException(Snackbar, Logger);
        }
    }

    public void Dispose()
    {
        AppStateStatic.HideAdvertising.Publish(false);
    }
}
