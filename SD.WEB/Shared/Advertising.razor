@inherits ComponentCore<Advertising>

@inject IpInfoApi IpInfoApi

@if (IgnoreRoutes.All(p => !Navigation.Uri.Contains(p)))
{
    if (Navigation.IsLocalhost())
    {
        <div style="text-align: center;" class="my-1">
            <MudLink Typo="Typo.caption" OnClick="OpenSubscription" Color="Color.Secondary">@Translations.Button.RemoveAdvertising</MudLink>
        </div>
        <div style="@($"height: 200px; text-align: center; align-content: center;")" class="@CssHelper.Build().Medium("mb").Raw("adsbygoogle custom-ad")">
            Advertising
        </div>
    }
    else
    {
        @if (Network != AdNetwork.None)
        {
            <div style="text-align: center;" class="my-1">
                <MudLink Typo="Typo.caption" OnClick="OpenSubscription" Color="Color.Secondary">@Translations.Button.RemoveAdvertising</MudLink>
            </div>
        }
        @if (Network == AdNetwork.Adsense)
        {
            <div id="@_containerId" @key="@_containerId" style="text-align: center; align-content: center; max-height: 200px !important;"
                 class="@CssHelper.Build().Medium("mb").Raw("adsbygoogle custom-ad")">
            </div>
        }
        else if (Network == AdNetwork.Yandex)
        {
            <div id="@($"yandex_rtb_{GetYandexSlotId(Slot)}")" @key="@_containerId" style="text-align: center; align-content: center; max-height: 200px !important;"
                 class="@CssHelper.Build().Medium("mb").Raw("adsbygoogle custom-ad")">
            </div>
        }
    }
}