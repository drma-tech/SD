@inherits ComponentParameterCore<MediaListFull>

@inject ExternalIdApi ExternalIdApi
@inject TmdbCreditApi TmdbCreditApi

@if (ShowHead)
{
    <PageSectionComponent Title="@GetTitle" Subtitle="@SubtitleHead" Icon="@Icon" Description="@Description"></PageSectionComponent>
}

<RenderControl State="State">
    <div class="grid-relative-container-poster">
        @foreach (var item in Items)
        {
            <NewPosterComponent MediaDetail="@item" OnlyYear="OnlyYear" FullPage="FullPage" CommentsSeparator="@CommentsSeparator"
                                Clicked="@OpenPopupMedia" WishList="Wish" CommentsIsImage="CommentsIsImage">
            </NewPosterComponent>
        }
    </div>
</RenderControl>
@if (MediaListApi != null)
{
    <div style="text-align: center;" class="@CssHelper.Build().Small("pt").Large("mb")">
        <MudButton StartIcon="@Icons.Material.Filled.ExpandMore" Color="Color.Primary" OnClick="@LoadMore" Disabled="@DisableLoadMore" Variant="Variant.Filled">
            @Translations.Button.LoadMore
        </MudButton>
    </div>
}

@if (!Popup)
{
    <FloatingButton Template="Template.Back"></FloatingButton>
}