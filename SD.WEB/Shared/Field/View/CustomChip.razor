@inherits FieldBase
@typeparam TValue

<span class="@Class" style="@Style">
    @if (Name.NotEmpty())
    {
        <MudChip T="string" Size="Size" Variant="Variant.Filled" Class="mx-0" Color="ColorName" Href="@NameHref" OnClick="NameClick">
            @Name
        </MudChip>
    }
    @if (Value != null)
    {
        @if (Value is bool resultB)
        {
            <MudChip T="string" Size="Size" Variant="Variant.Outlined" Class="@ValueChipClass" Color="ColorValue" Href="@ValueHref">
                <MudIcon Icon="@(resultB ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" Color="@(resultB ? Color.Success : Color.Error)"
                         Style="@($"margin-inline: -{(AppStateStatic.IsMobile ? 4 : 6)}px;")"></MudIcon>
                @if (IncludeBoolText)
                {
                    <span class="mud-chip-content ms-2">
                        @(resultB ? Translations.Notification.Yes : Translations.Notification.No)
                    </span>
                }
            </MudChip>
        }
        else if (Value is null)
        {
            <MudChip T="string" Size="Size" Variant="Variant.Outlined" Class="@ValueChipClass" Color="ColorValue" Href="@ValueHref" OnClick="ValueClick">
                @if (Image.NotEmpty())
                {
                    <MudImage Src="@Image" Alt="@Image" Class="me-1" Style="@ImageStyle"></MudImage>
                }
                @FallbackValue
            </MudChip>
        }
        else
        {
            <MudTooltip Text="@Tooltip">
                <MudChip T="string" Size="Size" Variant="Variant.Outlined" Class="@ValueChipClass" Color="ColorValue" Href="@ValueHref" OnClick="ValueClick">
                    @if (Image.NotEmpty())
                    {
                        <MudImage Src="@Image" Alt="@Tooltip" Class="me-1" Style="@ImageStyle"></MudImage>
                    }
                    @Value
                </MudChip>
            </MudTooltip>
        }
    }
</span>

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public string? FallbackValue { get; set; } = "N/A";
    [Parameter] public bool IncludeBoolText { get; set; } = true;
    [Parameter] public string? Tooltip { get; set; }

    [Parameter] public Color ColorName { get; set; } = Color.Default;
    [Parameter] public Color ColorValue { get; set; } = Color.Default;

    [Parameter] public string? NameHref { get; set; }
    [Parameter] public string? ValueHref { get; set; }

    [Parameter] public EventCallback NameClick { get; set; }
    [Parameter] public EventCallback ValueClick { get; set; }

    [Parameter] public string? Image { get; set; }
    [Parameter] public string? ImageStyle { get; set; }

    [Parameter] public string? ValueChipClass { get; set; } = "ms-1 me-0";
}
